 so it must be identical in A and B\n# or the comparison is confounded.\nIDENTITY_ANCHOR = \"same person, preserve facial identity\"\n\n# Negative prompt used for arm A. DSPy may propose its own for arm B; if it does\n# not, arm B inherits this one so the arms differ only in the positive prompt.\nBASE_NEGATIVE = (\"different person, distorted face, deformed, extra limbs, \"\n                 \"plastic skin, waxy, airbrushed, over-smoothed, blurry, lowres, watermark, text\")\n\ndef now_iso():\n    return datetime.datetime.now().isoformat(timespec=\"seconds\")\n\ndef sha1_of(img):\n    b = io.BytesIO(); img.convert(\"RGB\").save(b, \"PNG\")\n    return hashlib.sha1(b.getvalue()).hexdigest()[:12]\n\nprint(\"device :\", DEVICE, \"| torch\", torch.__version__)\nprint(\"root   :\", ROOT)\nprint(\"Cell 1 complete\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-08T07:25:28.690005Z","iopub.execute_input":"2026-08-08T07:25:28.691248Z","iopub.status.idle":"2026-08-08T07:25:28.713491Z","shell.execute_reply.started":"2026-08-08T07:25:28.691214Z","shell.execute_reply":"2026-08-08T07:25:28.712636Z"}},"outputs":[{"name":"stdout","text":"device : cuda | torch 2.10.0+cu128\nroot   : /kaggle/working/vs_dspy\nCell 1 complete\n","output_type":"stream"}],"execution_count":2},{"id":"d6d7862a-402c-400d-b066-af68dc4b1398","cell_type":"markdown","source":"## 2 · Mask engine\nComposable facial parts with conditional protection.\n\n**Check the output:** it must say `solutions` or `tasks`. If it says `haar`, MediaPipe failed to install — restart the session and rerun cell 0 before going further.","metadata":{}},{"id":"4e907358-8b66-4b1b-8401-55bfc8d54016","cell_type":"code","source":"# ── Cell 2 · MediaPipe landmarks + COMPOSABLE part mask engine ─────────────\n#\n# ARCHITECTURAL CHANGE vs. the old notebook\n# -----------------------------------------\n# Old: REGION_PARTS mapped an edit to exactly ONE of 8 fixed regions, and\n#      _poly_mask() then unconditionally SUBTRACTED eyes+nose (PROTECT_IDX)\n#      for the \"face\" and \"lower_face\" regions. Consequence: asking for eye\n#      makeup on the \"face\" region produced a mask with the eyelids punched\n#      out, so the edit silently did nothing.\n#\n# New: an edit resolves to a SET of parts that are unioned, plus a\n#      CONDITIONAL protect set. A part is only protected if the edit does not\n#      target it. Full-face makeup therefore covers the whole oval (nose,\n#      cheeks, lids, lips) and protects only the eye apertures; a nose job\n#      targets the nose and protects nothing; a de-ageing edit covers the oval\n#      and protects apertures + nose geometry.\n#\n# Every resolved mask is returned with an info dict that is written to the\n# dataset, so masking is a recorded variable rather than a hidden one.\n\n# ---------------------------------------------------------------- landmarks\nNOSE_IDX      = [1,2,4,5,6,19,44,45,51,94,97,98,115,122,125,168,195,197,236,274,\n                 275,281,344,351,354,440,220,305]\nNOSE_CORE_IDX = [1,2,4,5,6,168,197,195,98,327,115,344]\nFOREHEAD_IDX  = [10,338,297,332,284,251,21,54,103,67,109,151,108,337,69,299,104,\n                 333,105,334,66,296,65,295,107,336,9,8]\nLEFT_CHEEK_IDX  = [116,117,118,119,120,100,142,36,205,50,187,123,147,213]\nRIGHT_CHEEK_IDX = [345,346,347,348,349,329,371,266,425,280,411,352,376,433]\nLEFT_JAW_IDX    = [172,136,150,149,176,58,132,215,177,147,213,123]\nRIGHT_JAW_IDX   = [397,365,379,378,400,288,361,435,401,366,433,352]\nCHIN_IDX        = [152,148,176,377,400,149,378,150,379,175,171,396]\nFACE_OVAL_IDX   = [10,338,297,332,284,251,389,356,454,323,361,288,397,365,379,378,\n                   400,377,152,148,176,149,150,136,172,58,132,93,234,127,162,21,54,\n                   103,67,109]\nLOWERFACE_IDX   = [234,93,132,58,172,136,150,149,176,148,152,377,400,378,379,365,\n                   397,288,361,323,454,425,205,50,101,36,206,203,423,266,280,411]\nUNDER_EYE_L_IDX = [230,231,232,233,228,229,25,110,24,23,22,26,112]\nUNDER_EYE_R_IDX = [450,451,452,453,448,449,255,339,254,253,252,256,341]\nNASOLABIAL_L_IDX= [129,203,206,216,207,187,205,50,101,118,117]\nNASOLABIAL_R_IDX= [358,423,426,436,427,411,425,280,330,347,346]\nLIPS_IDX        = [61,146,91,181,84,17,314,405,321,375,291,409,270,269,267,0,37,39,\n                   40,185,76,77,90,180,85,16,315,404,320,307,306,408,304,303,302,11,\n                   72,73,74,184]\n# lid + crease only (NOT the eyeball) — this is what eyeshadow needs\nEYELID_L_IDX = [33,246,161,160,159,158,157,173,133,225,224,223,222,221,189]\nEYELID_R_IDX = [263,466,388,387,386,385,384,398,362,445,444,443,442,441,413]\nBROW_L_IDX   = [46,53,52,65,55,70,63,105,66,107]\nBROW_R_IDX   = [276,283,282,295,285,300,293,334,296,336]\n# the eye OPENING (iris + sclera). Protected during makeup so eye colour and\n# gaze are never regenerated, while the lid above it stays editable.\nEYE_APER_L_IDX = [33,7,163,144,145,153,154,155,133,173,157,158,159,160,161,246]\nEYE_APER_R_IDX = [263,249,390,373,374,380,381,382,362,398,384,385,386,387,388,466]\n\nPART_GROUPS = {\n    \"face_oval\":  [FACE_OVAL_IDX],\n    \"lower_face\": [LOWERFACE_IDX],\n    \"forehead\":   [FOREHEAD_IDX],\n    \"cheeks\":     [LEFT_CHEEK_IDX, RIGHT_CHEEK_IDX],\n    \"nose\":       [NOSE_IDX],\n    \"lips\":       [LIPS_IDX],\n    \"eyelids\":    [EYELID_L_IDX, EYELID_R_IDX],\n    \"brows\":      [BROW_L_IDX, BROW_R_IDX],\n    \"jaw\":        [LEFT_JAW_IDX, RIGHT_JAW_IDX],\n    \"chin\":       [CHIN_IDX],\n    \"under_eye\":  [UNDER_EYE_L_IDX, UNDER_EYE_R_IDX],\n    \"nasolabial\": [NASOLABIAL_L_IDX, NASOLABIAL_R_IDX],\n    # protect-only parts\n    \"eye_aperture\": [EYE_APER_L_IDX, EYE_APER_R_IDX],\n    \"nose_core\":    [NOSE_CORE_IDX],\n}\n\n# --------------------------------------------------------------- backends\n_BACKEND = None; _FM = None; _TASK = None\n\ndef _init_backend():\n    global _BACKEND, _FM, _TASK\n    if _BACKEND is not None: return _BACKEND\n    try:\n        import mediapipe as mp\n        _FM = mp.solutions.face_mesh.FaceMesh(static_image_mode=True, max_num_faces=1,\n                                              refine_landmarks=True, min_detection_confidence=0.4)\n        _BACKEND = \"solutions\"; return _BACKEND\n    except Exception:\n        pass\n    try:\n        import mediapipe as mp, urllib.request\n        from mediapipe.tasks import python as mpp\n        from mediapipe.tasks.python import vision as mpv\n        p = str(ROOT / \"face_landmarker.task\")\n        if not os.path.exists(p):\n            urllib.request.urlretrieve(\n                \"https://storage.googleapis.com/mediapipe-models/face_landmarker/\"\n                \"face_landmarker/float16/1/face_landmarker.task\", p)\n        _TASK = mpv.FaceLandmarker.create_from_options(\n            mpv.FaceLandmarkerOptions(base_options=mpp.BaseOptions(model_asset_path=p), num_faces=1))\n        _BACKEND = \"tasks\"; return _BACKEND\n    except Exception:\n        pass\n    _BACKEND = \"haar\"; return _BACKEND\n\n_HAAR = cv2.CascadeClassifier(cv2.data.haarcascades + \"haarcascade_frontalface_default.xml\")\n\ndef get_landmarks(pil):\n    b = _init_backend(); rgb = np.array(pil.convert(\"RGB\")); H, W = rgb.shape[:2]\n    if b == \"solutions\":\n        r = _FM.process(rgb)\n        if not r.multi_face_landmarks: return None, b\n        return np.array([[p.x*W, p.y*H] for p in r.multi_face_landmarks[0].landmark], np.float32), b\n    if b == \"tasks\":\n        import mediapipe as mp\n        r = _TASK.detect(mp.Image(image_format=mp.ImageFormat.SRGB, data=rgb))\n        if not r.face_landmarks: return None, b\n        return np.array([[p.x*W, p.y*H] for p in r.face_landmarks[0]], np.float32), b\n    return None, b\n\ndef _haar_rect(pil):\n    W, H = pil.size\n    gray = cv2.cvtColor(np.array(pil.convert(\"RGB\")), cv2.COLOR_RGB2GRAY)\n    f = _HAAR.detectMultiScale(gray, 1.05, 4, minSize=(40, 40))\n    if len(f) == 0:\n        fw, fh = int(W*0.6), int(H*0.6)\n        return ((W-fw)//2, int(H*0.18), fw, fh)\n    return tuple(max(f, key=lambda r: r[2]*r[3]))\n\n# ------------------------------------------------------------ mask builder\ndef _hull(size, pts, idxs, grow=0.10):\n    W, H = size; m = Image.new(\"L\", (W, H), 0)\n    idxs = [i for i in idxs if i < len(pts)]\n    if len(idxs) < 3: return m\n    sel = pts[idxs]\n    hull = cv2.convexHull(sel.astype(np.int32)).reshape(-1, 2)\n    cx, cy = float(sel[:, 0].mean()), float(sel[:, 1].mean())\n    poly = [(cx + (x-cx)*(1+grow), cy + (y-cy)*(1+grow)) for x, y in hull]\n    ImageDraw.Draw(m).polygon(poly, fill=255)\n    return m\n\ndef _union(size, pts, parts, grow):\n    acc = np.zeros((size[1], size[0]), np.uint8)\n    for part in parts:\n        for grp in PART_GROUPS.get(part, []):\n            acc = np.maximum(acc, np.array(_hull(size, pts, grp, grow)))\n    return acc\n\ndef _box_fallback(pil, parts):\n    \"\"\"No landmarks: draw a coarse ellipse so the app still runs.\"\"\"\n    W, H = pil.size; m = Image.new(\"L\", (W, H), 0); d = ImageDraw.Draw(m)\n    fx, fy, fw, fh = _haar_rect(pil)\n    if \"lips\" in parts and len(parts) == 1:\n        cx = fx + fw//2\n        d.ellipse([cx-int(fw*.22), fy+int(fh*.66), cx+int(fw*.22), fy+int(fh*.82)], fill=255)\n    elif set(parts) & {\"eyelids\", \"brows\"}:\n        for s in (-1, 1):\n            ex = fx + fw//2 + s*int(fw*.20)\n            d.ellipse([ex-int(fw*.16), fy+int(fh*.28), ex+int(fw*.16), fy+int(fh*.46)], fill=255)\n    elif \"nose\" in parts and len(parts) <= 2:\n        cx, cy = fx+fw//2, fy+int(fh*.50)\n        d.ellipse([cx-int(fw*.22), cy-int(fh*.24), cx+int(fw*.22), cy+int(fh*.24)], fill=255)\n    else:\n        pad = int(fw*0.10)\n        d.ellipse([max(0, fx-pad), max(0, fy-int(fh*.05)),\n                   min(W, fx+fw+pad), min(H, fy+fh+int(fh*.08))], fill=255)\n    return m.filter(ImageFilter.GaussianBlur(10))\n\ndef build_mask(pil, spec):\n    \"\"\"spec: dict(parts=[...], protect=[...], grow=float, blur=int, neck=bool)\n    Returns (PIL 'L' mask, info dict recorded in the dataset).\"\"\"\n    size = pil.size\n    parts   = list(spec.get(\"parts\", [\"face_oval\"]))\n    protect = [p for p in spec.get(\"protect\", []) if p not in parts]  # conditional\n    grow    = float(spec.get(\"grow\", 0.10))\n    blur    = int(spec.get(\"blur\", 8))\n    pts, backend = get_landmarks(pil)\n\n    if pts is None or len(pts) < 200:\n        m = _box_fallback(pil, parts)\n        used_backend = \"haar_fallback\"\n    else:\n        acc = _union(size, pts, parts, grow)\n        if spec.get(\"neck\"):\n            chin = pts[[i for i in CHIN_IDX if i < len(pts)]]\n            if len(chin):\n                tmp = Image.fromarray(acc)\n                cx = float(chin[:, 0].mean()); cy = float(chin[:, 1].max())\n                jw = float(chin[:, 0].max() - chin[:, 0].min()) or size[0]*0.25\n                ImageDraw.Draw(tmp).ellipse(\n                    [cx-jw*0.80, cy-jw*0.16, cx+jw*0.80, min(size[1], cy+jw*1.05)], fill=255)\n                acc = np.array(tmp)\n        if protect:\n            sub = _union(size, pts, protect, 0.06)\n            sub = np.array(Image.fromarray(sub).filter(ImageFilter.GaussianBlur(5)))\n            acc = np.clip(acc.astype(int) - sub.astype(int), 0, 255).astype(np.uint8)\n        m = Image.fromarray(acc).filter(ImageFilter.GaussianBlur(blur))\n        used_backend = backend\n\n    arr = np.array(m)\n    info = dict(\n        mask_parts    = \"|\".join(parts),\n        mask_protect  = \"|\".join(protect),\n        mask_grow     = grow,\n        mask_blur     = blur,\n        mask_neck     = bool(spec.get(\"neck\", False)),\n        mask_backend  = used_backend,\n        mask_coverage = round(float((arr > 32).mean()), 4),\n        mask_mean     = round(float(arr.mean()/255.0), 4),\n    )\n    return m, info\n\ndef mask_overlay(pil, mask, color=(255, 90, 30)):\n    base = np.array(pil.convert(\"RGB\"))\n    a = np.array(mask.convert(\"L\").resize(pil.size)) > 90\n    out = base.copy()\n    out[a] = (0.50*np.array(color) + 0.50*base[a]).astype(np.uint8)\n    edge = cv2.morphologyEx(a.astype(np.uint8), cv2.MORPH_GRADIENT,\n                            cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (5, 5)))\n    out[edge > 0] = color\n    return Image.fromarray(out)\n\n# ------------------------------------------------- compositing + texture\ndef composite(orig, gen, mask):\n    a = np.asarray(mask.convert(\"L\").resize(orig.size), np.float32)[:, :, None]/255.0\n    o = np.asarray(orig.convert(\"RGB\"), np.float32)\n    g = np.asarray(gen.convert(\"RGB\").resize(orig.size), np.float32)\n    return Image.fromarray((a*g + (1-a)*o).clip(0, 255).astype(np.uint8))\n\ndef texture_restore(orig, gen, mask, amount=0.30):\n    o = np.asarray(orig.convert(\"RGB\").resize(gen.size), np.float32)\n    g = np.asarray(gen.convert(\"RGB\"), np.float32)\n    hf = o - cv2.GaussianBlur(o, (0, 0), 3.0)\n    m = (np.asarray(mask.convert(\"L\").resize(gen.size), np.float32)/255.0)[:, :, None]\n    return Image.fromarray(np.clip(g + amount*hf*m, 0, 255).astype(np.uint8))\n\nprint(\"landmark backend:\", _init_backend())\nprint(\"parts available :\", \", \".join(sorted(PART_GROUPS)))\nprint(\"Cell 2 complete\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-08T07:25:36.515417Z","iopub.execute_input":"2026-08-08T07:25:36.516092Z","iopub.status.idle":"2026-08-08T07:25:36.66152Z","shell.execute_reply.started":"2026-08-08T07:25:36.516065Z","shell.execute_reply":"2026-08-08T07:25:36.660646Z"}},"outputs":[{"name":"stdout","text":"landmark backend: tasks\nparts available : brows, cheeks, chin, eye_aperture, eyelids, face_oval, forehead, jaw, lips, lower_face, nasolabial, nose, nose_core, under_eye\nCell 2 complete\n","output_type":"stream"},{"name":"stderr","text":"W0000 00:00:1786173936.617950     156 face_landmarker_graph.cc:180] Sets FaceBlendshapesGraph acceleration to xnnpack by default.\nW0000 00:00:1786173936.625825     161 inference_feedback_manager.cc:121] Feedback manager requires a model with a single signature inference. Disabling support for feedback tensors.\nW0000 00:00:1786173936.653866     160 inference_feedback_manager.cc:121] Feedback manager requires a model with a single signature inference. Disabling support for feedback tensors.\n","output_type":"stream"}],"execution_count":4},{"id":"deeaaba9-555c-4897-8b89-5613f2eea175","cell_type":"markdown","source":"## 3 · Intent parser\nFree text → part set + protect set + default strength. Multiple intents compose: *smokey eye and red lipstick* masks eyelids, brows and lips in one pass.","metadata":{}},{"id":"d1e3728e-2fff-40af-8ec7-5b2a3a519592","cell_type":"code","source":"# ── Cell 3 · Edit-intent parser: free text → mask spec ─────────────────────\n#\n# The user types anything (\"give her a smokey eye and red lips\"). This resolves\n# it to a part set + protect set + a default strength.\n#\n# Three things this has to get right, each of which is a bug if it doesn't:\n#\n#  1. WORD BOUNDARIES. Substring matching is unsafe on this vocabulary:\n#     \"important\" contains \"tan\", \"image\" contains \"age\", \"spotless\" contains\n#     \"spot\". Every keyword is compiled to a boundary-anchored regex.\n#\n#  2. PROTECT IS A UNION, NOT AN INTERSECTION. If any matched rule wants a part\n#     protected it stays protected, unless another rule explicitly targets it.\n#     With an intersection, \"smokey eye makeup and red lipstick\" ended up with\n#     nothing protected and the iris got regenerated.\n#\n#  3. GENERIC \"makeup\" MUST NOT SWALLOW SPECIFIC ONES. Bare \"makeup\" escalates\n#     to a whole-face mask only when no specific makeup rule matched, or when a\n#     genuine whole-face cue is present (foundation, contour, glam...).\n\ndef _rx(words):\n    return re.compile(r\"(?<![a-z])(\" + \"|\".join(re.escape(w) for w in words) + r\")(?![a-z])\", re.I)\n\nWHOLE_FACE_CUES = _rx([\"glam\", \"foundation\", \"contour\", \"contouring\", \"blush\", \"highlighter\",\n                       \"bronzer\", \"bridal\", \"full face\", \"full-face\", \"complexion\", \"base makeup\",\n                       \"whole face\", \"entire face\"])\nREMOVE_MAKEUP_RX = re.compile(\n    r\"(remove|without|no|take off|strip|clean off|free of)\\b[\\w\\s]{0,20}\\bmake[\\s-]?up|\"\n    r\"\\bmakeup[\\s-]?free\\b|\\bbare face\\b|\\bno cosmetics\\b\", re.I)\n\nINTENT_RULES = [\n    (\"remove_makeup\", REMOVE_MAKEUP_RX,\n        dict(parts=[\"face_oval\"], protect=[\"eye_aperture\"], grow=0.06, blur=9, strength=0.50)),\n\n    (\"eye_makeup\", _rx([\"eyeshadow\", \"eye shadow\", \"eyeliner\", \"eye liner\", \"mascara\", \"smokey\",\n                        \"smoky\", \"lashes\", \"eyelash\", \"eyelashes\", \"winged liner\", \"cut crease\",\n                        \"eye makeup\", \"kajal\", \"kohl\", \"eye make-up\"]),\n        dict(parts=[\"eyelids\", \"brows\"], protect=[\"eye_aperture\"], grow=0.14, blur=6, strength=0.46)),\n\n    (\"brows\", _rx([\"eyebrow\", \"eyebrows\", \"brow\", \"brows\", \"microblading\"]),\n        dict(parts=[\"brows\"], protect=[\"eye_aperture\"], grow=0.16, blur=5, strength=0.45)),\n\n    (\"lips\", _rx([\"lipstick\", \"lip gloss\", \"lip colour\", \"lip color\", \"lip tint\", \"lip liner\",\n                  \"lip filler\", \"fuller lips\", \"plumper lips\", \"plump lips\", \"matte lip\",\n                  \"lips\", \"lip\"]),\n        dict(parts=[\"lips\"], protect=[], grow=0.10, blur=5, strength=0.48)),\n\n    (\"full_makeup\", _rx([\"makeup\", \"make-up\", \"make up\", \"glam\", \"foundation\", \"contour\",\n                         \"contouring\", \"blush\", \"highlighter\", \"bronzer\", \"bridal\"]),\n        # nose is deliberately NOT protected: contour and highlight need the bridge\n        dict(parts=[\"face_oval\"], protect=[\"eye_aperture\"], grow=0.06, blur=9, strength=0.44)),\n\n    (\"beard\", _rx([\"beard\", \"stubble\", \"moustache\", \"mustache\", \"goatee\", \"facial hair\",\n                   \"shave\", \"shaven\", \"clean shaven\"]),\n        dict(parts=[\"lower_face\", \"chin\", \"jaw\", \"nasolabial\"], protect=[\"eye_aperture\"],\n             grow=0.10, blur=8, strength=0.52)),\n\n    (\"skin\", _rx([\"acne\", \"pimple\", \"pimples\", \"blemish\", \"blemishes\", \"spot\", \"spots\",\n                  \"clear skin\", \"smooth skin\", \"pores\", \"freckle\", \"freckles\", \"scar\",\n                  \"scars\", \"even skin tone\", \"complexion\", \"dark circles\"]),\n        dict(parts=[\"face_oval\"], protect=[\"eye_aperture\", \"lips\"], grow=0.05, blur=9, strength=0.46)),\n\n    (\"wrinkles\", _rx([\"wrinkle\", \"wrinkles\", \"botox\", \"fine lines\", \"smile lines\", \"crows feet\",\n                      \"crow's feet\", \"de-age\", \"deage\", \"younger\", \"youthful\", \"anti-aging\",\n                      \"anti aging\", \"older\", \"aged\", \"ageing\", \"aging\"]),\n        dict(parts=[\"forehead\", \"under_eye\", \"nasolabial\"], protect=[\"eye_aperture\"],\n             grow=0.08, blur=8, strength=0.44)),\n\n    (\"nose\", _rx([\"nose\", \"nasal\", \"rhinoplasty\", \"nose job\", \"nostril\", \"nostrils\",\n                  \"nose bridge\"]),\n        dict(parts=[\"nose\"], protect=[], grow=0.10, blur=6, strength=0.42)),\n\n    (\"slimming\", _rx([\"slim\", \"slimmer\", \"slimming\", \"thinner face\", \"jawline\", \"jaw line\",\n                      \"cheekbone\", \"cheekbones\", \"sculpt\", \"sculpted\", \"double chin\", \"chubby\",\n                      \"v-shape\", \"v shape\", \"face shape\", \"chiseled\"]),\n        dict(parts=[\"face_oval\"], protect=[\"eye_aperture\", \"nose_core\"],\n             grow=0.14, blur=10, strength=0.56, neck=True)),\n\n    (\"tan\", _rx([\"tan\", \"tanned\", \"sun-kissed\", \"sunkissed\", \"darker skin\", \"lighter skin\",\n                 \"glow\", \"glowy\", \"dewy\"]),\n        dict(parts=[\"face_oval\"], protect=[\"eye_aperture\"], grow=0.05, blur=9, strength=0.40)),\n]\n\nSPECIFIC_MAKEUP = {\"remove_makeup\", \"eye_makeup\", \"brows\", \"lips\"}\n\nDEFAULT_SPEC = dict(parts=[\"face_oval\"], protect=[\"eye_aperture\", \"nose_core\"],\n                    grow=0.08, blur=9, strength=0.44)\n\nUNSUPPORTED_RX = _rx([\"hair colour\", \"hair color\", \"hairstyle\", \"haircut\", \"hair\", \"background\",\n                      \"clothes\", \"clothing\", \"outfit\", \"shirt\", \"earring\", \"earrings\",\n                      \"necklace\", \"glasses\", \"hat\", \"teeth\", \"tooth\"])\n\n_SUBSUMED = {\"cheeks\", \"forehead\", \"lower_face\", \"jaw\", \"chin\", \"eyelids\", \"brows\", \"under_eye\",\n             \"nasolabial\"}\n\ndef resolve_intent(text):\n    \"\"\"free text -> (spec dict, matched rule names, warning str or '')\"\"\"\n    t = (text or \"\")\n    matched = [(name, spec) for name, rx, spec in INTENT_RULES if rx.search(t)]\n    names = [n for n, _ in matched]\n\n    if \"full_makeup\" in names and (set(names) & SPECIFIC_MAKEUP) and not WHOLE_FACE_CUES.search(t):\n        matched = [(n, s) for n, s in matched if n != \"full_makeup\"]\n        names = [n for n, _ in matched]\n\n    if not matched:\n        spec, rules = dict(DEFAULT_SPEC), [\"default_face\"]\n    else:\n        parts, protect = [], set()\n        strengths, grows, blurs, neck = [], [], [], False\n        for _, s in matched:\n            parts += s[\"parts\"]\n            protect |= set(s.get(\"protect\", []))          # UNION, not intersection\n            strengths.append(s[\"strength\"])\n            grows.append(s[\"grow\"]); blurs.append(s[\"blur\"])\n            neck = neck or bool(s.get(\"neck\", False))\n        parts = list(dict.fromkeys(parts))\n        if \"face_oval\" in parts:\n            parts = [\"face_oval\"] + [p for p in parts if p != \"face_oval\" and p not in _SUBSUMED]\n        protect -= set(parts)                              # never protect a targeted part\n        spec = dict(parts=parts, protect=sorted(protect),\n                    grow=float(np.mean(grows)), blur=int(round(np.mean(blurs))),\n                    strength=float(max(strengths)), neck=neck)\n        rules = names\n\n    m = UNSUPPORTED_RX.search(t)\n    warn = (f\"'{m.group(0)}' is outside the face mask, so that part of the request will have no \"\n            \"effect. Only facial regions are editable.\") if m else \"\"\n    return spec, rules, warn\n\ndef spec_summary(spec, rules):\n    return (f\"intent: {', '.join(rules)}\\nmask parts: {', '.join(spec['parts'])}\"\n            f\"\\nprotected: {', '.join(spec['protect']) or 'none'}\"\n            f\"\\nstrength: {spec['strength']:.2f}\")\n\nfor _p in [\"smokey eye makeup and red lipstick\", \"remove all her makeup\", \"add a thick beard\",\n           \"make the nose smaller\", \"soft glam makeup for a wedding\", \"an important portrait\",\n           \"change her hair color to blonde\", \"clear up the acne\", \"slimmer jawline\"]:\n    _s, _r, _w = resolve_intent(_p)\n    print(f\"  {_p:36s} -> {'+'.join(_r):26s} parts={_s['parts']} protect={_s['protect']}\")\n\nprint(\"Cell 3 complete\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-08T07:25:44.159912Z","iopub.execute_input":"2026-08-08T07:25:44.160359Z","iopub.status.idle":"2026-08-08T07:25:44.187562Z","shell.execute_reply.started":"2026-08-08T07:25:44.160333Z","shell.execute_reply":"2026-08-08T07:25:44.186746Z"}},"outputs":[{"name":"stdout","text":"  smokey eye makeup and red lipstick   -> eye_makeup+lips            parts=['eyelids', 'brows', 'lips'] protect=['eye_aperture']\n  remove all her makeup                -> remove_makeup              parts=['face_oval'] protect=['eye_aperture']\n  add a thick beard                    -> beard                      parts=['lower_face', 'chin', 'jaw', 'nasolabial'] protect=['eye_aperture']\n  make the nose smaller                -> nose                       parts=['nose'] protect=[]\n  soft glam makeup for a wedding       -> full_makeup                parts=['face_oval'] protect=['eye_aperture']\n  an important portrait                -> default_face               parts=['face_oval'] protect=['eye_aperture', 'nose_core']\n  change her hair color to blonde      -> default_face               parts=['face_oval'] protect=['eye_aperture', 'nose_core']\n  clear up the acne                    -> skin                       parts=['face_oval'] protect=['eye_aperture', 'lips']\n  slimmer jawline                      -> slimming                   parts=['face_oval'] protect=['eye_aperture', 'nose_core']\nCell 3 complete\n","output_type":"stream"}],"execution_count":5},{"id":"b96fb851-efef-402f-9b6b-f64d528cf22d","cell_type":"markdown","source":"## 4 · Renderer\nOne pipeline, no adapters. `render_pair()` is where the experimental control lives.","metadata":{}},{"id":"95c84a75-f0e0-42d6-8e9c-8bee8cc2e7a6","cell_type":"code","source":"# ── Cell 4 · Stable Diffusion inpaint pipeline + PAIRED render ─────────────\n#\n# ARCHITECTURAL CHANGE: no IP-Adapter, no LoRA, no reference images. Those were\n# in the old notebook to teach a surgery \"look\"; here they would be uncontrolled\n# variables sitting between the prompt and the output. The pipeline is now a\n# plain inpainter so that the prompt is the only thing that differs between arms.\n#\n# render_pair() enforces the experimental control: ONE mask, ONE seed, ONE\n# strength, ONE checkpoint, rendered twice with two prompts.\n\nfrom diffusers import StableDiffusionInpaintPipeline, EulerDiscreteScheduler\n\n_PIPE = None\n\ndef get_pipe():\n    global _PIPE\n    if _PIPE is not None: return _PIPE\n    print(\"loading\", RENDER[\"repo\"], \"...\")\n    p = StableDiffusionInpaintPipeline.from_pretrained(\n        RENDER[\"repo\"], torch_dtype=DTYPE, use_safetensors=True, safety_checker=None)\n    p.scheduler = EulerDiscreteScheduler.from_config(p.scheduler.config)\n    p.to(DEVICE)\n    if DEVICE == \"cuda\":\n        p.enable_attention_slicing()\n        try: p.enable_vae_tiling()\n        except Exception: pass\n    p.set_progress_bar_config(disable=True)\n    _PIPE = p\n    print(\"pipeline ready\")\n    return _PIPE\n\ndef _prep(src):\n    \"\"\"Square-resize for the UNet, remembering the original aspect.\"\"\"\n    S = RENDER[\"size\"]\n    return src.convert(\"RGB\").resize((S, S), Image.LANCZOS), src.size\n\ndef render_one(square_src, mask, positive, negative, strength, seed):\n    pipe = get_pipe()\n    g = torch.Generator(device=DEVICE).manual_seed(int(seed))\n    out = pipe(prompt=positive, negative_prompt=negative,\n               image=square_src, mask_image=mask,\n               strength=float(strength),\n               num_inference_steps=RENDER[\"steps\"],\n               guidance_scale=RENDER[\"guidance\"],\n               generator=g).images[0]\n    out = composite(square_src, out, mask)\n    out = texture_restore(square_src, out, mask, RENDER[\"texture_addback\"])\n    return out\n\ndef render_pair(src_img, mask, prompt_a, neg_a, prompt_b, neg_b, strength, seed):\n    \"\"\"Same source, same mask, same seed, same strength -> only the prompt differs.\"\"\"\n    square, orig_size = _prep(src_img)\n    m = mask.resize((RENDER[\"size\"], RENDER[\"size\"]), Image.BILINEAR)\n    t0 = time.time()\n    img_a = render_one(square, m, prompt_a, neg_a, strength, seed)\n    img_b = render_one(square, m, prompt_b, neg_b, strength, seed)\n    dt = round(time.time() - t0, 1)\n    return img_a.resize(orig_size, Image.LANCZOS), img_b.resize(orig_size, Image.LANCZOS), dt\n\nprint(\"Cell 4 complete  (pipeline loads lazily on first generation)\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-08T07:25:48.62851Z","iopub.execute_input":"2026-08-08T07:25:48.629341Z","iopub.status.idle":"2026-08-08T07:25:54.501964Z","shell.execute_reply.started":"2026-08-08T07:25:48.629312Z","shell.execute_reply":"2026-08-08T07:25:54.501285Z"}},"outputs":[{"name":"stderr","text":"Flax classes are deprecated and will be removed in Diffusers v1.0.0. We recommend migrating to PyTorch classes or pinning your version of Diffusers.\nFlax classes are deprecated and will be removed in Diffusers v1.0.0. We recommend migrating to PyTorch classes or pinning your version of Diffusers.\n","output_type":"stream"},{"name":"stdout","text":"Cell 4 complete  (pipeline loads lazily on first generation)\n","output_type":"stream"}],"execution_count":6},{"id":"8c9860d5-0844-420a-b3ee-93508d482196","cell_type":"markdown","source":"## 5 · DSPy rewriter\nZero-shot, format contract in the signature docstring, deterministic validator behind it.\n\nSet `USE_LOCAL_LM = True` if you have no `OPENAI_API_KEY` secret. **Check the output:** it should name a backend, not `NONE`.","metadata":{}},{"id":"9c07f501-0897-44fd-b3ad-979817c41a3b","cell_type":"code","source":"# ── Cell 5 · DSPy prompt rewriter ──────────────────────────────────────────\n#\n# ARCHITECTURAL CHANGE: the old module was\n#     RecommendEdit: (skin_tone, concerns) -> edit_key, prompt\n# optimised against reward_metric(), which returned AVG(human_score) for that\n# edit key from the old database. The reward never saw the prompt text or the\n# image, so the optimiser could only learn \"pick the highest-rated category\".\n# It was a lookup table with an LLM in front of it.\n#\n# The new module rewrites the USER'S OWN prompt:\n#     RewriteEditPrompt: (edit_request, mask_parts) -> positive_prompt, negative_prompt\n#\n# It is zero-shot. There is no compile() step and no teleprompter, because a\n# metric that tracks human judgement does not exist yet -- building the dataset\n# to train one is the point of this notebook. The task constraints therefore\n# live in the signature docstring, which means a validated metric found later\n# can be dropped in as a compile step without touching the module.\n\nimport dspy\n\n# ------------------------------------------------------------- LM backend\nLM_BACKEND = \"none\"\n\ndef _try_openai():\n    global LM_BACKEND\n    key = os.environ.get(\"OPENAI_API_KEY\")\n    if not key:\n        try:\n            from kaggle_secrets import UserSecretsClient\n            key = UserSecretsClient().get_secret(\"OPENAI_API_KEY\")\n            os.environ[\"OPENAI_API_KEY\"] = key\n        except Exception:\n            return False\n    try:\n        dspy.configure(lm=dspy.LM(\"openai/gpt-4o-mini\", max_tokens=400, temperature=0.7))\n        LM_BACKEND = \"openai/gpt-4o-mini\"; return True\n    except Exception as e:\n        print(\"openai backend unavailable:\", str(e)[:70]); return False\n\ndef _try_local(model_id=\"Qwen/Qwen2.5-3B-Instruct\"):\n    \"\"\"4-bit local LM. ~2.5 GB, leaves room for SD 1.5 on a single 16 GB GPU.\"\"\"\n    global LM_BACKEND\n    try:\n        from transformers import AutoTokenizer, AutoModelForCausalLM, BitsAndBytesConfig\n        from types import SimpleNamespace\n        bnb = BitsAndBytesConfig(load_in_4bit=True, bnb_4bit_quant_type=\"nf4\",\n                                 bnb_4bit_use_double_quant=True,\n                                 bnb_4bit_compute_dtype=torch.float16)\n        tok = AutoTokenizer.from_pretrained(model_id)\n        hf = AutoModelForCausalLM.from_pretrained(model_id, quantization_config=bnb,\n                                                  device_map=\"auto\", torch_dtype=torch.float16)\n        hf.eval()\n\n        class LocalHFLM(dspy.BaseLM):\n            def __init__(self):\n                super().__init__(model=model_id)\n                self.tok, self.hf, self.kwargs = tok, hf, {\"temperature\": 0.7, \"max_tokens\": 400}\n            def _gen(self, messages):\n                ids = self.tok.apply_chat_template(messages, add_generation_prompt=True,\n                                                   return_tensors=\"pt\").to(self.hf.device)\n                with torch.no_grad():\n                    out = self.hf.generate(ids, max_new_tokens=400, do_sample=True,\n                                           temperature=0.7, top_p=0.9,\n                                           pad_token_id=self.tok.eos_token_id)\n                return self.tok.decode(out[0][ids.shape[-1]:], skip_special_tokens=True)\n            def forward(self, prompt=None, messages=None, **kw):\n                messages = messages or [{\"role\": \"user\", \"content\": prompt}]\n                txt = self._gen(messages)\n                return SimpleNamespace(\n                    choices=[SimpleNamespace(message=SimpleNamespace(content=txt),\n                                             finish_reason=\"stop\")],\n                    usage=SimpleNamespace(prompt_tokens=0, completion_tokens=0, total_tokens=0),\n                    model=model_id)\n            def __call__(self, prompt=None, messages=None, **kw):\n                return [self._gen(messages or [{\"role\": \"user\", \"content\": prompt}])]\n\n        dspy.configure(lm=LocalHFLM())\n        LM_BACKEND = model_id; return True\n    except Exception as e:\n        print(\"local backend unavailable:\", str(e)[:90]); return False\n\nUSE_LOCAL_LM = False       # set True to force the local model instead of OpenAI\nif USE_LOCAL_LM:\n    _try_local() or _try_openai()\nelse:\n    _try_openai() or _try_local()\n\n# dspy.configure() binds the LM to the CALLING THREAD. Gradio runs every event\n# handler in a worker thread, where dspy.settings.lm would be empty. Capture the\n# object here and bind it explicitly at call time with dspy.context().\nLM_OBJ = getattr(dspy.settings, \"lm\", None)\nprint(\"DSPy LM backend:\", LM_BACKEND or \"NONE (rule-based fallback only)\")\n\n# ------------------------------------------------------------- signature\nclass RewriteEditPrompt(dspy.Signature):\n    \"\"\"Rewrite a user's face-edit request into a Stable Diffusion inpainting prompt.\n\nFORMAT (mandatory)\n  Comma-separated visual tags only. No sentences. No instruction verbs.\n  Stable Diffusion does not follow instructions; the text encoder embeds every\n  word as a visual concept, so words like \"ensure\", \"while\", \"maintain\" and\n  \"focus on\" become visual noise rather than directions.\n\nRULES\n  1. Never use 4k, 8k, hyperrealistic, hyperdetailed, masterpiece, ultra sharp,\n     RAW photo, best quality, award winning. These hype tags degrade skin realism.\n  2. Describe concrete visible things: colour, finish, placement, skin texture,\n     fine hairs, pores, and lighting. Not abstract quality claims.\n  3. Preserve the user's intent exactly. If the request REMOVES something, the\n     prompt must not contain any tag describing that thing.\n  4. Only describe what is inside the masked region listed in mask_parts.\n     Do not describe hair, clothing, background or accessories.\n  5. positive_prompt: 6 to 12 tags, under 40 words.\n  6. negative_prompt: 4 to 8 tags naming the artefacts to avoid for THIS edit.\n\"\"\"\n    edit_request    = dspy.InputField(desc=\"what the user typed, verbatim\")\n    mask_parts      = dspy.InputField(desc=\"facial regions the edit may touch\")\n    positive_prompt = dspy.OutputField(desc=\"comma-separated visual tags only, no sentences\")\n    negative_prompt = dspy.OutputField(desc=\"comma-separated artefact tags only\")\n\n_REWRITER = dspy.ChainOfThought(RewriteEditPrompt)\n\n# ------------------------------------------------------------- validator\nHYPE_RE  = re.compile(r\"\\b(4k|8k|hyper-?realistic|hyper-?detailed|masterpiece|ultra[- ]sharp|\"\n                      r\"raw photo|best quality|award[- ]winning|trending on artstation|octane)\\b\", re.I)\nPROSE_RE = re.compile(r\"\\b(ensure|ensuring|maintain|maintaining|while|preserving|focus on|\"\n                      r\"make sure|should|must|please|remember|keep the|in order to)\\b\", re.I)\nREMOVAL_RE = re.compile(r\"\\b(remove|without|no |get rid of|erase|clear|delete|shave|strip)\\b\", re.I)\n\nREMOVAL_TERMS = {\n    \"beard\": [\"beard\", \"stubble\", \"facial hair\", \"moustache\", \"mustache\", \"goatee\", \"hair strands\"],\n    \"makeup\": [\"lipstick\", \"eyeshadow\", \"eyeliner\", \"mascara\", \"blush\", \"makeup\", \"foundation\"],\n    \"acne\":   [\"acne\", \"pimple\", \"blemish\", \"spot\"],\n    \"wrinkle\": [\"wrinkle\", \"fine line\", \"crow\", \"creases\"],\n}\n\ndef clean_prompt(s):\n    s = (s or \"\").strip()\n    s = re.sub(r\"^(here('s| is)[^:]*:|sure[,!.]?|output:|positive prompt:|prompt:)\\s*\", \"\", s, flags=re.I)\n    s = s.replace(\"\\n\", \", \").strip().strip(\".\").strip()\n    s = re.sub(r\"\\s*,\\s*\", \", \", s)\n    s = re.sub(r\"(,\\s*){2,}\", \", \", s)\n    return s.strip(\" ,\")\n\ndef validate_prompt(text, request):\n    \"\"\"Returns list of flag strings. Empty list = passed.\"\"\"\n    flags = []\n    if not text: return [\"empty\"]\n    if HYPE_RE.search(text):  flags.append(\"hype\")\n    if PROSE_RE.search(text): flags.append(\"prose_verb\")\n    if text.count(\",\") < 3:   flags.append(\"too_few_tags\")\n    if len(text.split()) > 45: flags.append(\"too_long\")\n    if len([c for c in text if c in \".!?\"]) >= 2: flags.append(\"sentences\")\n    if REMOVAL_RE.search(request or \"\"):\n        low = text.lower()\n        for _, terms in REMOVAL_TERMS.items():\n            if any(t in (request or \"\").lower() for t in terms):\n                if any(t in low for t in terms):\n                    flags.append(\"contradiction\"); break\n    return flags\n\ndef repair_prompt(text):\n    \"\"\"Deterministic fixes for the two flags that can be repaired without an LM.\"\"\"\n    text = HYPE_RE.sub(\"\", text)\n    text = PROSE_RE.sub(\"\", text)\n    return clean_prompt(text)\n\n# ------------------------------------------------- rule-based arm-B fallback\nTEXTURE_TAGS = (\"natural skin pores, visible skin texture, soft even lighting, \"\n                \"photographic detail, not airbrushed\")\n\ndef rule_rewrite(request, parts):\n    body = clean_prompt(request)\n    return f\"{body}, {TEXTURE_TAGS}\", BASE_NEGATIVE\n\n# ------------------------------------------------------------- public API\n_REWRITE_CACHE = {}\n_FIRST_ERROR = {}\n\ndef dspy_rewrite(request, parts, use_cache=True):\n    \"\"\"Returns dict(positive, negative, source, flags, latency_s).\n    source is one of: dspy | dspy_repaired | rule_fallback | cache\"\"\"\n    request = (request or \"\").strip()\n    if not request:\n        return dict(positive=\"\", negative=\"\", source=\"empty\", flags=[\"empty\"], latency_s=0.0)\n\n    key = (request, \"|\".join(parts))\n    if use_cache and key in _REWRITE_CACHE:\n        out = dict(_REWRITE_CACHE[key]); out[\"source\"] += \"+cache\"; return out\n\n    t0 = time.time()\n    pos = neg = \"\"; source = \"rule_fallback\"; flags = []\n    if LM_OBJ is not None:\n        try:\n            with dspy.context(lm=LM_OBJ):          # thread-safe LM binding\n                pred = _REWRITER(edit_request=request, mask_parts=\", \".join(parts))\n            pos = clean_prompt(getattr(pred, \"positive_prompt\", \"\"))\n            neg = clean_prompt(getattr(pred, \"negative_prompt\", \"\"))\n            flags = validate_prompt(pos, request)\n            if pos and set(flags) <= {\"hype\", \"prose_verb\"} and flags:\n                pos = repair_prompt(pos)\n                flags = validate_prompt(pos, request)\n                source = \"dspy_repaired\"\n            elif pos and not flags:\n                source = \"dspy\"\n            elif pos:\n                source = \"dspy_flagged\"\n        except Exception as e:\n            flags = [\"exception:\" + type(e).__name__]\n            if \"shown\" not in _FIRST_ERROR:         # surface the real reason once\n                _FIRST_ERROR[\"shown\"] = True\n                print(\"\\n!! FIRST LM ERROR:\", type(e).__name__, str(e)[:400], \"\\n\")\n\n    if not pos or source == \"rule_fallback\":\n        pos, neg = rule_rewrite(request, parts)\n        source = \"rule_fallback\"; flags = flags or [\"lm_unavailable\"]\n\n    if not neg:\n        neg = BASE_NEGATIVE\n\n    out = dict(positive=pos, negative=neg, source=source, flags=flags,\n               latency_s=round(time.time()-t0, 2))\n    if source.startswith(\"dspy\"):                  # never cache a failure\n        _REWRITE_CACHE[key] = dict(out)\n    return out\n\ndef selftest_lm():\n    \"\"\"Run before any batch. Must print PASS.\"\"\"\n    r = dspy_rewrite(\"smokey eye makeup\", [\"eyelids\", \"brows\"], use_cache=False)\n    print(\"source :\", r[\"source\"]); print(\"flags  :\", r[\"flags\"])\n    print(\"prompt :\", r[\"positive\"][:200])\n    ok = r[\"source\"].startswith(\"dspy\")\n    print(\"\\n\" + (\"PASS — LM working, safe to run the batch.\"\n                  if ok else \"FAIL — do not run the batch.\"))\n    return ok\n\ndef build_arm_a(request):\n    \"\"\"Arm A = the user's text, untouched, plus the shared identity anchor.\"\"\"\n    return f\"{clean_prompt(request)}, {IDENTITY_ANCHOR}\", BASE_NEGATIVE\n\ndef build_arm_b(rewrite):\n    \"\"\"Arm B = the DSPy rewrite plus the SAME identity anchor.\"\"\"\n    return f\"{rewrite['positive']}, {IDENTITY_ANCHOR}\", rewrite[\"negative\"]\n\nprint(\"Cell 5 complete\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-08T07:25:58.372132Z","iopub.execute_input":"2026-08-08T07:25:58.373298Z","iopub.status.idle":"2026-08-08T07:25:58.484537Z","shell.execute_reply.started":"2026-08-08T07:25:58.373264Z","shell.execute_reply":"2026-08-08T07:25:58.483694Z"}},"outputs":[{"name":"stdout","text":"DSPy LM backend: openai/gpt-4o-mini\nCell 5 complete\n","output_type":"stream"}],"execution_count":7},{"id":"b8570cff-b290-4aec-9d32-46a5c1503eaa","cell_type":"markdown","source":"## 6 · Store","metadata":{}},{"id":"4baf11de-d3ea-4140-83b5-1fb5b0b44aaf","cell_type":"code","source":"# ── Cell 6 · Dataset store (flat CSV + PNG tree) ───────────────────────────\n#\n# ARCHITECTURAL CHANGE: the old data_layer.py carried a SQLite schema plus an\n# optional Supabase mirror, with tables for human_score, skin_tone, lip_shade\n# and per-face iteration groups -- all of it shaped around the scored dataset\n# that has been removed. One CSV plus a PNG tree covers everything the new\n# study records, and it is portable: the annotation packs read the same files.\n\nPAIR_FIELDS = [\n    \"pair_id\", \"timestamp\", \"session\",\n    # source\n    \"source_path\", \"source_sha1\", \"source_w\", \"source_h\",\n    # request + prompts\n    \"edit_request\", \"prompt_a\", \"negative_a\", \"prompt_b\", \"negative_b\",\n    \"rewrite_source\", \"rewrite_flags\", \"rewrite_latency_s\",\n    # mask\n    \"mask_path\", \"mask_parts\", \"mask_protect\", \"mask_grow\", \"mask_blur\",\n    \"mask_neck\", \"mask_backend\", \"mask_coverage\", \"mask_mean\", \"intent_rules\",\n    # render settings\n    \"seed\", \"strength\", \"model_key\", \"model_repo\", \"steps\", \"guidance\", \"size\",\n    \"texture_addback\", \"identity_anchor\", \"lm_backend\", \"gen_time_s\",\n    # outputs\n    \"image_a\", \"image_b\",\n]\n\ndef _append_row(path, fields, row):\n    new = not os.path.exists(path)\n    with open(path, \"a\", newline=\"\", encoding=\"utf-8\") as f:\n        w = csv.DictWriter(f, fieldnames=fields, extrasaction=\"ignore\")\n        if new: w.writeheader()\n        w.writerow(row)\n\ndef save_pair(src_img, mask, img_a, img_b, request, arm_a, arm_b, rewrite,\n              mask_info, intent_rules, seed, strength, gen_time, session=\"s1\"):\n    pid = uuid.uuid4().hex[:10]\n    d = IMG / pid; d.mkdir(parents=True, exist_ok=True)\n    p_src  = d / \"source.png\";  src_img.convert(\"RGB\").save(p_src)\n    p_mask = d / \"mask.png\";    mask.convert(\"L\").save(p_mask)\n    p_a    = d / \"arm_a.png\";   img_a.convert(\"RGB\").save(p_a)\n    p_b    = d / \"arm_b.png\";   img_b.convert(\"RGB\").save(p_b)\n\n    row = dict(\n        pair_id=pid, timestamp=now_iso(), session=session,\n        source_path=str(p_src), source_sha1=sha1_of(src_img),\n        source_w=src_img.size[0], source_h=src_img.size[1],\n        edit_request=request,\n        prompt_a=arm_a[0], negative_a=arm_a[1],\n        prompt_b=arm_b[0], negative_b=arm_b[1],\n        rewrite_source=rewrite[\"source\"], rewrite_flags=\"|\".join(rewrite[\"flags\"]),\n        rewrite_latency_s=rewrite[\"latency_s\"],\n        mask_path=str(p_mask), intent_rules=\"|\".join(intent_rules),\n        seed=int(seed), strength=round(float(strength), 3),\n        model_key=RENDER[\"model_key\"], model_repo=RENDER[\"repo\"],\n        steps=RENDER[\"steps\"], guidance=RENDER[\"guidance\"], size=RENDER[\"size\"],\n        texture_addback=RENDER[\"texture_addback\"], identity_anchor=IDENTITY_ANCHOR,\n        lm_backend=LM_BACKEND, gen_time_s=gen_time,\n        image_a=str(p_a), image_b=str(p_b),\n        **mask_info,\n    )\n    _append_row(PAIRS_CSV, PAIR_FIELDS, row)\n    return pid, row\n\ndef load_pairs():\n    if not os.path.exists(PAIRS_CSV):\n        return pd.DataFrame(columns=PAIR_FIELDS)\n    return pd.read_csv(PAIRS_CSV)\n\ndef store_summary():\n    df = load_pairs()\n    if df.empty: return \"no pairs recorded yet\"\n    src = df.rewrite_source.value_counts().to_dict()\n    return (f\"{len(df)} pairs | {df.source_sha1.nunique()} unique faces | \"\n            f\"{df.edit_request.nunique()} unique requests | rewrite source: {src}\")\n\nprint(\"store ready ->\", PAIRS_CSV)\nprint(store_summary())\nprint(\"Cell 6 complete\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-08T07:26:04.810563Z","iopub.execute_input":"2026-08-08T07:26:04.811101Z","iopub.status.idle":"2026-08-08T07:26:04.830589Z","shell.execute_reply.started":"2026-08-08T07:26:04.811069Z","shell.execute_reply":"2026-08-08T07:26:04.829738Z"}},"outputs":[{"name":"stdout","text":"store ready -> /kaggle/working/vs_dspy/pairs.csv\nno pairs recorded yet\nCell 6 complete\n","output_type":"stream"}],"execution_count":8},{"id":"33555d85-2192-4ba7-b1dd-12d79ec6817b","cell_type":"markdown","source":"## 7 · Request variation set + batch driver\n60 requests: 15 categories × 4 quality registers.\n\nIf the face scan returns 0, attach a face dataset via **Add Data**, or upload photos to `/kaggle/working/faces/` and rerun this cell.","metadata":{}},{"id":"3670ce44-92a8-4e6d-b418-4e82b2ddbf84","cell_type":"code","source":"# ── Cell 7 · Prompt variation set + batch generation ───────────────────────\n#\n# WHY THE REGISTERS EXIST\n# A rewriter can only be shown to help where the input has headroom. If every\n# request is already a competent tag list, arm B has nothing to improve and the\n# study cannot detect an effect that has nowhere to appear. So each edit\n# category is written at four quality registers:\n#\n#   bare    one or two words                     -> maximum headroom\n#   prose   how a real user actually types        -> CLIP handles prose badly\n#   hype    8k / masterpiece / hyperrealistic     -> known to score ~1.5/5\n#   tagged  an already-good comma-separated list  -> CONTROL: no gain expected\n#\n# The \"tagged\" rows are not filler. If arm B beats them too, that is either a\n# real finding or a sign of annotator bias, and you want to see which.\n\nREGISTERS = [\"bare\", \"prose\", \"hype\", \"tagged\"]\n\nREQUEST_SET = {\n \"lipstick\":     [\"lipstick\",\n                  \"could you put a nice red lipstick on her please\",\n                  \"8k hyperrealistic masterpiece flawless glossy lipstick ultra detailed\",\n                  \"deep red matte lipstick, defined lip line, soft natural lip texture\"],\n \"eye_makeup\":   [\"smokey eye\",\n                  \"give her a smokey eye like she is going to a party\",\n                  \"8k hyperdetailed dramatic smokey eye masterpiece award winning\",\n                  \"blended charcoal eyeshadow, soft smudged liner, defined lashes, natural lid texture\"],\n \"full_makeup\":  [\"makeup\",\n                  \"can you do a soft glam makeup look for a wedding\",\n                  \"masterpiece flawless 8k full glam makeup ultra sharp perfect skin\",\n                  \"soft matte foundation, neutral eyeshadow, rosy blush, groomed brows, visible skin pores\"],\n \"remove_makeup\":[\"no makeup\",\n                  \"please remove all of her makeup so she looks natural\",\n                  \"8k hyperrealistic bare face no makeup masterpiece clean flawless\",\n                  \"bare face, no lipstick, no eyeshadow, no blush, natural pale lips, visible pores\"],\n \"beard_add\":    [\"beard\",\n                  \"add a full thick beard to him\",\n                  \"8k hyperdetailed masterpiece thick beard ultra sharp facial hair\",\n                  \"full dark beard, dense individual hair strands, natural growth pattern, matte skin\"],\n \"beard_remove\": [\"shave\",\n                  \"remove his beard completely so he is clean shaven\",\n                  \"hyperrealistic 8k clean shaven flawless masterpiece smooth\",\n                  \"clean shaven jaw, bare skin, faint shadow, natural skin pores, no facial hair\"],\n \"skin_acne\":    [\"clear skin\",\n                  \"can you clear up the acne on her face\",\n                  \"8k flawless perfect poreless skin masterpiece hyperrealistic\",\n                  \"clear even complexion, blemishes removed, natural skin pores retained, soft lighting\"],\n \"wrinkles\":     [\"younger\",\n                  \"make her look about ten years younger please\",\n                  \"8k hyperrealistic youthful flawless masterpiece anti aging perfect\",\n                  \"reduced fine lines, softened nasolabial folds, firm skin, natural pores, rested eyes\"],\n \"older\":        [\"older\",\n                  \"age him up so he looks like he is in his sixties\",\n                  \"8k hyperdetailed elderly masterpiece ultra realistic aged\",\n                  \"deep forehead lines, crows feet, softened jaw, thinner skin, age spots, natural texture\"],\n \"nose\":         [\"smaller nose\",\n                  \"make her nose a bit thinner and more refined\",\n                  \"masterpiece 8k perfect refined nose hyperrealistic ultra sharp\",\n                  \"narrower nasal bridge, refined tip, smaller nostrils, natural skin texture, even lighting\"],\n \"slimming\":     [\"slimmer face\",\n                  \"slim her face down and sharpen the jawline\",\n                  \"8k hyperrealistic chiseled sculpted jawline masterpiece perfect\",\n                  \"narrower cheeks, defined jawline, visible cheekbones, natural skin texture\"],\n \"brows\":        [\"eyebrows\",\n                  \"shape her eyebrows so they look neater\",\n                  \"8k perfect flawless eyebrows masterpiece hyperdetailed\",\n                  \"groomed arched brows, defined tail, individual brow hairs, natural skin\"],\n \"tan\":          [\"tan\",\n                  \"give her a sun kissed tanned glow\",\n                  \"8k hyperrealistic golden glowing tanned skin masterpiece flawless\",\n                  \"warm sun tanned skin, soft sheen, even tone, visible pores, natural lighting\"],\n \"freckles\":     [\"freckles\",\n                  \"add some light freckles across her nose and cheeks\",\n                  \"8k hyperdetailed perfect freckles masterpiece ultra sharp\",\n                  \"scattered light freckles, across nose bridge and cheeks, natural skin texture\"],\n \"dark_circles\": [\"dark circles\",\n                  \"get rid of the dark circles under his eyes\",\n                  \"8k flawless bright under eyes masterpiece hyperrealistic perfect\",\n                  \"brightened under-eye area, reduced shadowing, natural skin texture, rested look\"],\n}\n\nFLAT_REQUESTS = [(cat, REGISTERS[i], txt)\n                 for cat, lst in REQUEST_SET.items() for i, txt in enumerate(lst)]\n\n# ------------------------------------------------------------- face sourcing\ndef find_faces(patterns=None, limit=40, verbose=True):\n    \"\"\"Collect source photos with a detectable face from attached datasets.\"\"\"\n    pats = patterns or [\"/kaggle/input/**/*.jpg\", \"/kaggle/input/**/*.jpeg\",\n                        \"/kaggle/input/**/*.png\", \"/kaggle/working/faces/*.*\",\n                        str(ROOT / \"faces\" / \"*.*\")]\n    seen = []\n    for p in pats:\n        seen += glob.glob(p, recursive=True)\n    seen = sorted(set(seen))\n    keep = []\n    for f in seen:\n        try:\n            im = Image.open(f).convert(\"RGB\")\n            if min(im.size) < 256:\n                continue\n            pts, _ = get_landmarks(im)\n            if pts is not None and len(pts) > 200:\n                keep.append(f)\n        except Exception:\n            continue\n        if len(keep) >= limit:\n            break\n    if verbose:\n        print(f\"scanned {len(seen)} files, kept {len(keep)} with a detected face\")\n    return keep\n\ndef clear_batch():\n    \"\"\"Discard a contaminated run. batch_generate skips (face, request) pairs it\n    has already seen, so a re-run without this generates nothing.\"\"\"\n    import shutil\n    if os.path.exists(PAIRS_CSV):\n        shutil.move(str(PAIRS_CSV), str(ROOT / f\"pairs_discarded_{int(time.time())}.csv\"))\n    if IMG.exists(): shutil.rmtree(str(IMG))\n    IMG.mkdir(parents=True, exist_ok=True)\n    for f in PACKS.glob(\"pack_*.html\"): f.unlink()\n    _REWRITE_CACHE.clear()\n    print(\"cleared —\", store_summary())\n\n# ------------------------------------------------------------ batch driver\ndef batch_generate(faces, target_pairs=200, session=\"batch1\", seed0=20260808):\n    \"\"\"Generator yielding progress lines. Resumable: skips (face, request) pairs\n    already present in pairs.csv, so a dead session can just be rerun.\"\"\"\n    if not faces:\n        yield \"no source faces found — attach a face dataset or upload to /kaggle/working/faces/\"\n        return\n\n    done = set()\n    prev = load_pairs()\n    if not prev.empty:\n        done = set(zip(prev.source_sha1.astype(str), prev.edit_request.astype(str)))\n        yield f\"resuming — {len(done)} pairs already recorded\"\n\n    # Face must rotate EVERY pair. A face-major plan (face = faces[k // 60])\n    # spends the first 60 pairs on one face, so a 200-pair run touches only 4.\n    # Rotating by request index keeps register balance exact while spreading faces.\n    nF, nR = len(faces), len(FLAT_REQUESTS)\n    plan = []\n    for rnd in range(math.ceil(target_pairs / nR) + 3):\n        for i, (cat, reg, req) in enumerate(FLAT_REQUESTS):\n            plan.append((faces[(i + rnd * 7) % nF], req, cat, reg))\n\n    rng = random.Random(seed0)\n    made = skipped = failed = 0\n    t0 = time.time(); src_seen = set()\n    for face, req, cat, reg in plan:\n        if made >= target_pairs:\n            break\n        try:\n            src = Image.open(face).convert(\"RGB\")\n            h = sha1_of(src)\n            if (h, req) in done:\n                skipped += 1\n                continue\n            spec, rules, _ = resolve_intent(req)\n            mask, info = build_mask(src, spec)\n            if info[\"mask_backend\"] == \"haar_fallback\":\n                skipped += 1\n                continue                                   # no landmarks -> unusable row\n            rw = dspy_rewrite(req, spec[\"parts\"])\n            arm_a, arm_b = build_arm_a(req), build_arm_b(rw)\n            seed = rng.randint(0, 2**31 - 1)\n            ia, ib, dt = render_pair(src, mask, arm_a[0], arm_a[1],\n                                     arm_b[0], arm_b[1], spec[\"strength\"], seed)\n            save_pair(src, mask, ia, ib, req, arm_a, arm_b, rw, info,\n                      rules + [f\"register:{reg}\", f\"category:{cat}\"],\n                      seed, spec[\"strength\"], dt, session)\n            done.add((h, req)); made += 1\n            if made % 5 == 0 or made == 1:\n                el = time.time() - t0\n                eta = el/made*(target_pairs-made)/60\n\n        except Exception as e:\n            failed += 1\n            yield f\"FAIL {cat}/{reg}: {type(e).__name__}: {str(e)[:70]}\"\n            if failed > 15:\n                yield \"too many failures — stopping\"; break\n\n    yield f\"DONE — {made} pairs, {len(src_seen)} distinct faces, {skipped} skipped, {failed} failed\"\n    yield store_summary()\n\ndef run_batch(faces, target_pairs=200, session=\"batch1\"):\n    \"\"\"Blocking version for use directly in a notebook cell.\"\"\"\n    for line in batch_generate(faces, target_pairs, session):\n        print(line)\n\nFACES = find_faces(limit=40)\nprint(f\"{len(REQUEST_SET)} categories x {len(REGISTERS)} registers = {len(FLAT_REQUESTS)} requests\")\nprint(\"Cell 7 complete — use the Batch tab, or run: run_batch(FACES, 200)\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-08T07:26:09.768811Z","iopub.execute_input":"2026-08-08T07:26:09.769263Z","iopub.status.idle":"2026-08-08T07:26:24.50675Z","shell.execute_reply.started":"2026-08-08T07:26:09.769227Z","shell.execute_reply":"2026-08-08T07:26:24.505983Z"}},"outputs":[{"name":"stdout","text":"scanned 4964 files, kept 40 with a detected face\n15 categories x 4 registers = 60 requests\nCell 7 complete — use the Batch tab, or run: run_batch(FACES, 200)\n","output_type":"stream"}],"execution_count":9},{"id":"d5435239-64dd-4e90-bf4c-b2ef19c55ced","cell_type":"markdown","source":"## 8 · Annotation interface","metadata":{}},{"id":"1338f14a-20fa-489c-967e-e2aacbe6a485","cell_type":"code","source":"# ── Cell 8 · Annotation interface (HTML template) ──────────────────────────\n#\n# Design constraints that come from the task, not from taste:\n#   * Achromatic surround. A coloured background shifts perceived skin tone via\n#     simultaneous contrast and would bias the very ratings being collected.\n#   * No web fonts, no CDN, no server. Annotators open the file offline.\n#   * The source photo is always visible. Identity preservation cannot be judged\n#     without it — this is the gap in the previous scoring app, which showed\n#     only the two generated arms.\n#   * Left/right randomised per pair, recorded in the manifest, invisible to\n#     the annotator.\n\nANNOT_TEMPLATE = r\"\"\"<!DOCTYPE html>\n<html lang=\"en\"><head>\n<meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Face edit comparison — __ANNOTATOR__</title>\n<style>\n:root{\n  --bg:#181818; --card:#212121; --line:#333; --ink:#ececec; --dim:#8e8e8e;\n  --sel:#4fb6c4; --sel-ink:#06272c;\n}\n*{box-sizing:border-box}\nbody{margin:0;background:var(--bg);color:var(--ink);\n  font:15px/1.5 ui-sans-serif,system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}\n.mono{font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace}\nheader{position:sticky;top:0;z-index:5;background:var(--bg);border-bottom:1px solid var(--line);\n  padding:10px 20px;display:flex;align-items:center;gap:18px}\nh1{font-size:15px;font-weight:600;margin:0}\n.count{font-size:13px;color:var(--dim);letter-spacing:.06em}\n.bar{flex:1;height:3px;background:var(--line);border-radius:2px;overflow:hidden}\n.fill{height:100%;width:0;background:var(--sel);transition:width .25s ease}\nmain{max-width:1120px;margin:0 auto;padding:20px}\n.req{background:var(--card);border:1px solid var(--line);border-radius:6px;padding:10px 14px;margin-bottom:14px}\n.req b{color:var(--dim);font-weight:500;font-size:12px;letter-spacing:.08em;\n  text-transform:uppercase;display:block;margin-bottom:3px}\n.imgs{display:grid;grid-template-columns:0.72fr 1fr 1fr;gap:12px;align-items:start}\nfigure{margin:0}\nfigcaption{font-size:12px;color:var(--dim);text-align:center;padding:6px 0;letter-spacing:.04em}\nimg{width:100%;display:block;border-radius:6px;background:#000}\n.q{margin-top:18px;border-top:1px solid var(--line);padding-top:14px}\n.sec{color:var(--dim);font-size:12px;letter-spacing:.08em;text-transform:uppercase;margin-bottom:8px}\n.qrow{display:flex;align-items:center;gap:14px;margin-bottom:11px;flex-wrap:wrap}\n.qlab{width:210px;font-size:14px}\n.qlab small{display:block;color:var(--dim);font-size:12px}\n.opts{display:flex;gap:6px}\nbutton.opt{background:var(--card);border:1px solid var(--line);color:var(--ink);\n  min-width:44px;padding:8px 12px;border-radius:5px;cursor:pointer;font-size:14px}\nbutton.opt:hover{border-color:#555}\nbutton.opt[aria-pressed=\"true\"]{background:var(--sel);border-color:var(--sel);color:var(--sel-ink);font-weight:600}\nbutton.opt:focus-visible{outline:2px solid var(--sel);outline-offset:2px}\n.wide{min-width:104px}\nnav{display:flex;justify-content:space-between;align-items:center;margin-top:22px;gap:12px}\nbutton.nav{background:transparent;border:1px solid var(--line);color:var(--ink);\n  padding:9px 18px;border-radius:5px;cursor:pointer}\nbutton.nav.primary{background:var(--sel);border-color:var(--sel);color:var(--sel-ink);font-weight:600}\nbutton.nav:disabled{opacity:.35;cursor:not-allowed}\n.keys{font-size:12px;color:var(--dim);margin-top:16px;line-height:1.8}\n.keys kbd{background:var(--card);border:1px solid var(--line);border-bottom-width:2px;\n  border-radius:3px;padding:1px 6px;font-family:ui-monospace,monospace;font-size:11px}\n.done{text-align:center;padding:64px 20px}\n@media (max-width:820px){.imgs{grid-template-columns:1fr 1fr}figure.src{grid-column:1/-1;max-width:280px}}\n@media (prefers-reduced-motion:reduce){*{transition:none!important}}\n</style></head><body>\n\n<header>\n  <h1>Face edit comparison</h1>\n  <span class=\"count mono\" id=\"count\">01 / 00</span>\n  <div class=\"bar\"><div class=\"fill\" id=\"fill\"></div></div>\n  <span class=\"count mono\">__ANNOTATOR__</span>\n</header>\n<main id=\"main\"></main>\n\n<script>\nconst ANNOTATOR = \"__ANNOTATOR__\";\nconst ITEMS = __ITEMS__;\nconst KEY = \"vsdspy_\" + ANNOTATOR;\nlet answers = {}, i = 0;\ntry { answers = JSON.parse(localStorage.getItem(KEY) || \"{}\"); } catch(e) { answers = {}; }\n\nconst Q = [\n  {id:\"realism\",  label:\"Realism\",            hint:\"Does it look like a real photograph?\", type:\"scale\"},\n  {id:\"identity\", label:\"Identity preserved\", hint:\"Still clearly the same person?\",       type:\"scale\"},\n  {id:\"followed\", label:\"Followed the request\",hint:\"Was the requested edit actually made?\",type:\"scale\"}\n];\n\nfunction save(){ try{ localStorage.setItem(KEY, JSON.stringify(answers)); }catch(e){} }\nfunction cur(){ return answers[ITEMS[i].pair_id] ||= {}; }\n\nfunction sideBlock(side){\n  const a = cur()[side] || {};\n  return Q.map(q => `\n    <div class=\"qrow\">\n      <span class=\"qlab\">${q.label} <small>${q.hint}</small></span>\n      <span class=\"opts\">${[1,2,3,4,5].map(v =>\n        `<button class=\"opt\" data-side=\"${side}\" data-q=\"${q.id}\" data-v=\"${v}\"\n          aria-pressed=\"${a[q.id]==v}\">${v}</button>`).join(\"\")}</span>\n    </div>`).join(\"\");\n}\n\nfunction render(){\n  const it = ITEMS[i], a = cur();\n  document.getElementById(\"count\").textContent =\n    String(i+1).padStart(2,\"0\") + \" / \" + String(ITEMS.length).padStart(2,\"0\");\n  document.getElementById(\"fill\").style.width = (i/ITEMS.length*100) + \"%\";\n  document.getElementById(\"main\").innerHTML = `\n    <div class=\"req\"><b>Edit requested</b>${it.request.replace(/</g,\"&lt;\")}</div>\n    <div class=\"imgs\">\n      <figure class=\"src\"><img src=\"${it.src}\" alt=\"original photo\"><figcaption>ORIGINAL</figcaption></figure>\n      <figure><img src=\"${it.left}\" alt=\"version left\"><figcaption>LEFT</figcaption></figure>\n      <figure><img src=\"${it.right}\" alt=\"version right\"><figcaption>RIGHT</figcaption></figure>\n    </div>\n    <div class=\"q\"><div class=\"sec\">Left image</div>${sideBlock(\"left\")}</div>\n    <div class=\"q\"><div class=\"sec\">Right image</div>${sideBlock(\"right\")}</div>\n    <div class=\"q\"><div class=\"qrow\">\n      <span class=\"qlab\">Overall preference <small>Which would you keep?</small></span>\n      <span class=\"opts\">\n        <button class=\"opt wide\" data-pref=\"left\"  aria-pressed=\"${a.preferred=='left'}\">Left</button>\n        <button class=\"opt wide\" data-pref=\"tie\"   aria-pressed=\"${a.preferred=='tie'}\">Tie</button>\n        <button class=\"opt wide\" data-pref=\"right\" aria-pressed=\"${a.preferred=='right'}\">Right</button>\n      </span></div></div>\n    <nav>\n      <button class=\"nav\" id=\"prev\" ${i==0?\"disabled\":\"\"}>Back</button>\n      <span class=\"count mono\" id=\"status\"></span>\n      <button class=\"nav primary\" id=\"next\">${i==ITEMS.length-1?\"Finish\":\"Next\"}</button>\n    </nav>\n    <div class=\"keys\">\n      <kbd>1</kbd>-<kbd>5</kbd> score the focused row &nbsp;·&nbsp; <kbd>Tab</kbd> next row &nbsp;·&nbsp;\n      <kbd>&larr;</kbd> <kbd>&rarr;</kbd> prefer left / right &nbsp;·&nbsp; <kbd>T</kbd> tie &nbsp;·&nbsp;\n      <kbd>Enter</kbd> next pair. Progress is saved in this browser, so you can close the file and come back.\n    </div>`;\n  wire();\n}\n\nfunction wire(){\n  document.querySelectorAll(\"button.opt\").forEach(b => b.onclick = () => {\n    const a = cur();\n    if (b.dataset.pref) { a.preferred = b.dataset.pref; }\n    else { (a[b.dataset.side] ||= {})[b.dataset.q] = +b.dataset.v; }\n    save(); render();\n  });\n  document.getElementById(\"prev\").onclick = () => { if(i>0){ i--; render(); } };\n  document.getElementById(\"next\").onclick = () => {\n    const a = cur(), need = [];\n    for (const s of [\"left\",\"right\"]) for (const q of Q)\n      if (!(a[s]||{})[q.id]) need.push(s + \" \" + q.label.toLowerCase());\n    if (!a.preferred) need.push(\"preference\");\n    if (need.length) { document.getElementById(\"status\").textContent =\n      \"missing: \" + need.slice(0,3).join(\", \") + (need.length>3 ? \" ...\" : \"\"); return; }\n    if (i < ITEMS.length-1) { i++; render(); } else { finish(); }\n  };\n}\n\ndocument.addEventListener(\"keydown\", e => {\n  if (e.key >= \"1\" && e.key <= \"5\") {\n    const f = document.activeElement;\n    if (f && f.dataset && f.dataset.q) {\n      const t = document.querySelector(\n        `button.opt[data-side=\"${f.dataset.side}\"][data-q=\"${f.dataset.q}\"][data-v=\"${e.key}\"]`);\n      if (t) { t.click(); e.preventDefault(); }\n    }\n  }\n  if (e.key === \"ArrowLeft\")  { document.querySelector('[data-pref=\"left\"]')?.click(); }\n  if (e.key === \"ArrowRight\") { document.querySelector('[data-pref=\"right\"]')?.click(); }\n  if (e.key.toLowerCase() === \"t\") { document.querySelector('[data-pref=\"tie\"]')?.click(); }\n  if (e.key === \"Enter\" && !e.shiftKey) { document.getElementById(\"next\")?.click(); }\n});\n\nfunction finish(){\n  const head = [\"annotator_id\",\"pair_id\",\"position\",\"left_realism\",\"left_identity\",\n    \"left_followed\",\"right_realism\",\"right_identity\",\"right_followed\",\"preferred_side\",\"submitted_at\"];\n  const rows = [head.join(\",\")];\n  ITEMS.forEach(it => {\n    const a = answers[it.pair_id] || {}, L = a.left || {}, R = a.right || {};\n    rows.push([ANNOTATOR, it.pair_id, it.idx, L.realism||\"\", L.identity||\"\", L.followed||\"\",\n      R.realism||\"\", R.identity||\"\", R.followed||\"\", a.preferred||\"\",\n      new Date().toISOString()].join(\",\"));\n  });\n  const blob = new Blob([rows.join(\"\\n\")], {type:\"text/csv\"});\n  const url = URL.createObjectURL(blob);\n  const a = document.createElement(\"a\");\n  a.href = url; a.download = \"annotations_\" + ANNOTATOR + \".csv\"; a.click();\n  document.getElementById(\"fill\").style.width = \"100%\";\n  document.getElementById(\"main\").innerHTML =\n    '<div class=\"done\"><h2>All ' + ITEMS.length + ' pairs done</h2>' +\n    '<p style=\"color:var(--dim)\">Your CSV downloaded as <span class=\"mono\">annotations_' +\n    ANNOTATOR + '.csv</span>. Please send that file back.</p>' +\n    '<button class=\"nav\" onclick=\"i=0;render()\">Review my answers</button></div>';\n}\n\nrender();\n</script></body></html>\n\"\"\"\nprint(\"Cell 8 complete — annotation template loaded\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-08T07:26:59.06305Z","iopub.execute_input":"2026-08-08T07:26:59.063393Z","iopub.status.idle":"2026-08-08T07:26:59.073573Z","shell.execute_reply.started":"2026-08-08T07:26:59.063367Z","shell.execute_reply":"2026-08-08T07:26:59.072843Z"}},"outputs":[{"name":"stdout","text":"Cell 8 complete — annotation template loaded\n","output_type":"stream"}],"execution_count":10},{"id":"ecea042c-b75b-420c-a8aa-fe89f65793f0","cell_type":"markdown","source":"## 9 · Pack builder and export","metadata":{}},{"id":"4e1fcfb9-f9fc-47f9-8664-937399281a8e","cell_type":"code","source":"# ── Cell 9 · Annotation pack builder + export ──────────────────────────────\n\nANNOTATORS     = 12\nPAIRS_PER_PACK = 20     # ~10 minutes at ~30 s per pair\nOVERLAP        = 2      # raters per pair -> inter-annotator agreement\nTHUMB_PX       = 448\n\ndef _b64(path, px=THUMB_PX, q=78):\n    im = Image.open(path).convert(\"RGB\")\n    im.thumbnail((px, px), Image.LANCZOS)\n    b = io.BytesIO(); im.save(b, \"JPEG\", quality=q, optimize=True)\n    return \"data:image/jpeg;base64,\" + base64.b64encode(b.getvalue()).decode()\n\ndef build_packs(annotators=ANNOTATORS, per_pack=PAIRS_PER_PACK, overlap=OVERLAP, seed=7):\n    \"\"\"Writes packs/pack_Axx.html + pack_manifest.csv. Returns a log string.\"\"\"\n    df = load_pairs()\n    log = []\n    if df.empty:\n        return \"no pairs to annotate yet — generate some first\"\n\n    need = annotators * per_pack / max(1, overlap)\n    if len(df) < need:\n        log.append(f\"note: {len(df)} pairs available, {need:.0f} needed for full coverage \"\n                   f\"at {annotators} x {per_pack} / overlap {overlap}. Packs will repeat pairs.\")\n\n    rng = random.Random(seed)\n    pool = [r for _, r in df.iterrows()] * overlap\n    rng.shuffle(pool)\n\n    # Deal into packs, never placing the same pair twice in one annotator's pack.\n    # Without this, a duplicated pair produces two identical (annotator, pair) keys,\n    # which becomes a many-to-many join at merge time and silently inflates n.\n    packs, seen = [[] for _ in range(annotators)], [set() for _ in range(annotators)]\n    leftover = []\n    for r in pool:\n        placed = False\n        order = sorted(range(annotators), key=lambda k: len(packs[k]))\n        for k in order:\n            if len(packs[k]) < per_pack and r[\"pair_id\"] not in seen[k]:\n                packs[k].append(r); seen[k].add(r[\"pair_id\"]); placed = True; break\n        if not placed:\n            leftover.append(r)\n    if leftover:\n        log.append(f\"note: {len(leftover)} placements dropped — too few distinct pairs \"\n                   f\"for {annotators} x {per_pack} at overlap {overlap}. Generate more pairs.\")\n\n    for f in PACKS.glob(\"pack_*.html\"):\n        f.unlink()\n\n    manifest = []\n    for k, rows in enumerate(packs, start=1):\n        if not rows: continue\n        aid = f\"A{k:02d}\"\n        items = []\n        for i, r in enumerate(rows):\n            left_arm  = rng.choice([\"A\", \"B\"])\n            left_img  = r[\"image_a\"] if left_arm == \"A\" else r[\"image_b\"]\n            right_img = r[\"image_b\"] if left_arm == \"A\" else r[\"image_a\"]\n            items.append(dict(idx=i, pair_id=r[\"pair_id\"], request=str(r[\"edit_request\"]),\n                              src=_b64(r[\"source_path\"]), left=_b64(left_img), right=_b64(right_img)))\n            manifest.append(dict(annotator_id=aid, pair_id=r[\"pair_id\"], position=i,\n                                 left_arm=left_arm, right_arm=(\"B\" if left_arm == \"A\" else \"A\")))\n        html = ANNOT_TEMPLATE.replace(\"__ANNOTATOR__\", aid).replace(\"__ITEMS__\", json.dumps(items))\n        out = PACKS / f\"pack_{aid}.html\"\n        out.write_text(html, encoding=\"utf-8\")\n        log.append(f\"{out.name}  ({len(items)} pairs, {out.stat().st_size/1e6:.1f} MB)\")\n\n    pd.DataFrame(manifest).to_csv(MANIFEST_CSV, index=False)\n    log.append(f\"manifest -> {MANIFEST_CSV}  ({len(manifest)} rows)\")\n    log.append(\"Send each annotator THEIR OWN pack_Axx.html. Keep the manifest safe: \"\n               \"without it the returned CSVs cannot be decoded.\")\n    return \"\\n\".join(log)\n\n# ------------------------------------------------------------------ export\ndef export_all(dest=\"/kaggle/working\"):\n    \"\"\"Zips packs + the whole data tree, and copies the two critical CSVs out.\"\"\"\n    import shutil\n    dest = pathlib.Path(dest)\n    made = []\n    if any(PACKS.glob(\"pack_*.html\")):\n        p = shutil.make_archive(str(dest / \"annotation_packs\"), \"zip\", str(PACKS)); made.append(p)\n    made.append(shutil.make_archive(str(dest / \"vs_dspy_data\"), \"zip\", str(ROOT)))\n    for f in (MANIFEST_CSV, PAIRS_CSV):\n        tgt = dest / os.path.basename(f)\n        if os.path.exists(f) and os.path.abspath(str(f)) != os.path.abspath(str(tgt)):\n            shutil.copy(str(f), str(tgt)); made.append(str(tgt))\n    out = \"\\n\".join(f\"  {m}  ({os.path.getsize(m)/1e6:.1f} MB)\" for m in made)\n    return (\"Download these from the Kaggle Output panel, then hit Save Version:\\n\" + out +\n            \"\\n\\npack_manifest.csv is the critical one — it holds the left/right randomisation.\")\n\ndef dataset_report():\n    df = load_pairs()\n    if df.empty: return \"no pairs yet\"\n    reg = df.intent_rules.astype(str).str.extract(r\"register:(\\w+)\")[0].value_counts().to_dict()\n    cat = df.intent_rules.astype(str).str.extract(r\"category:(\\w+)\")[0].nunique()\n    lines = [\n        f\"pairs            {len(df)}\",\n        f\"unique faces     {df.source_sha1.nunique()}\",\n        f\"unique requests  {df.edit_request.nunique()}   (categories seen: {cat})\",\n        f\"registers        {reg or 'n/a (single-pair mode only)'}\",\n        f\"mask backend     {df.mask_backend.value_counts().to_dict()}\",\n        f\"rewrite source   {df.rewrite_source.value_counts().to_dict()}\",\n        f\"mean gen time    {pd.to_numeric(df.gen_time_s, errors='coerce').mean():.1f}s per pair\",\n    ]\n    bad = df[df.mask_backend == \"haar_fallback\"]\n    if len(bad): lines.append(f\"WARNING  {len(bad)} rows used the coarse fallback mask — exclude these\")\n    fb = df[df.rewrite_source.astype(str).str.startswith(\"rule_fallback\")]\n    if len(fb): lines.append(f\"WARNING  {len(fb)} rows fell back to rule rewrite — arm B ~= arm A there\")\n    return \"\\n\".join(lines)\n\nprint(\"Cell 9 complete — build_packs(), export_all(), dataset_report()\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-08T07:27:05.067054Z","iopub.execute_input":"2026-08-08T07:27:05.067411Z","iopub.status.idle":"2026-08-08T07:27:05.087265Z","shell.execute_reply.started":"2026-08-08T07:27:05.067383Z","shell.execute_reply":"2026-08-08T07:27:05.08633Z"}},"outputs":[{"name":"stdout","text":"Cell 9 complete — build_packs(), export_all(), dataset_report()\n","output_type":"stream"}],"execution_count":11},{"id":"8e8376da-0d85-48af-a768-3ae8f883e306","cell_type":"markdown","source":"## 10 · The app\nLaunches non-blocking. The `*.gradio.live` link is for you only — it expires in 72 hours and dies with the session.","metadata":{}},{"id":"af4681fd-6f19-4a2e-9736-08074fe80978","cell_type":"code","source":"# ── Cell 10 · VISION STUDIO — Studio · Batch · Dataset · Annotation ────────\n# Original Vision Studio look and tabbed layout, rebuilt around the DSPy\n# prompt-comparison study. Launches non-blocking, so cells below stay runnable.\n\nimport gradio as gr\n\nCSS = \"\"\"\n@import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600&display=swap');\n:root{--bg:#0a0c10;--panel:#12161d;--panel2:#161b24;--line:#232c39;\n      --ink:#eef2f8;--sub:#93a1b4;--amber:#ffb347;--orange:#ff7a45;--gold:#ffd166}\n*{font-family:'Inter',system-ui,sans-serif}\nh1,h2,h3,.gr-button{font-family:'Space Grotesk','Inter',sans-serif!important;letter-spacing:-.01em}\n.gradio-container{max-width:100%!important;\n  background:radial-gradient(1200px 600px at 15% -10%,#1a1206 0%,transparent 55%),\n             radial-gradient(1000px 500px at 100% 0%,#1a0e08 0%,transparent 50%),\n             var(--bg)!important;color:var(--ink)!important}\n#topbar{display:flex;align-items:center;justify-content:space-between;\n  padding:16px 22px;margin-bottom:6px;border-radius:18px;\n  background:linear-gradient(100deg,rgba(255,122,69,.14),rgba(255,209,102,.05));\n  border:1px solid var(--line)}\n#brand{font-family:'Space Grotesk';font-weight:700;font-size:26px;\n  background:linear-gradient(90deg,#ffd166,#ff7a45);-webkit-background-clip:text;\n  background-clip:text;color:transparent}\n#brand small{display:block;font-family:'Inter';font-weight:500;font-size:12px;\n  color:var(--sub);letter-spacing:.04em;-webkit-text-fill-color:var(--sub)}\n.block,.form,.panel{background:var(--panel)!important;border-color:var(--line)!important}\n.gr-button-primary{background:linear-gradient(90deg,#ff7a45,#ffb347)!important;\n  border:none!important;color:#1a0e08!important;font-weight:600!important}\n#rw textarea,#orig textarea,#meta textarea,#log textarea{\n  font-family:ui-monospace,SFMono-Regular,Menlo,monospace!important;font-size:12.5px!important}\n#rw textarea{border-left:3px solid var(--gold)!important}\n#orig textarea{border-left:3px solid var(--sub)!important}\n.tabitem{background:var(--panel2)!important}\nfooter{display:none!important}\n\"\"\"\n\nHEADER = \"\"\"<div id='topbar'><div id='brand'>Vision Studio\n<small>DSPy prompt rewriting · paired human evaluation</small></div>\n<div style='color:#93a1b4;font-size:12px;text-align:right'>arm A = your prompt &nbsp;·&nbsp;\narm B = DSPy rewrite<br>same photo · same mask · same seed · same strength</div></div>\"\"\"\n\n# ------------------------------------------------------------------ Studio\ndef ui_live(img, request):\n    if not (request or \"\").strip():\n        return None, \"\", \"\", \"\"\n    spec, rules, warn = resolve_intent(request)\n    rw = dspy_rewrite(request, spec[\"parts\"])\n    pa, _ = build_arm_a(request)\n    pb, _ = build_arm_b(rw)\n    meta = spec_summary(spec, rules)\n    meta += f\"\\nrewrite: {rw['source']}\"\n    if rw[\"flags\"]: meta += f\"   flags: {', '.join(rw['flags'])}\"\n    if warn: meta += f\"\\n\\n{warn}\"\n    prev = None\n    if img is not None:\n        try:\n            m, info = build_mask(img, spec)\n            prev = mask_overlay(img, m)\n            meta += f\"\\nmask coverage: {info['mask_coverage']:.1%}  ({info['mask_backend']})\"\n        except Exception as e:\n            meta += f\"\\nmask preview failed: {str(e)[:60]}\"\n    return prev, pa, pb, meta\n\ndef ui_generate(img, request, seed, strength, rand, session):\n    if img is None: raise gr.Error(\"Upload a face photo first.\")\n    if not (request or \"\").strip(): raise gr.Error(\"Type an edit request first.\")\n    spec, rules, _ = resolve_intent(request)\n    if rand: seed = random.randint(0, 2**31 - 1)\n    strength = float(strength or spec[\"strength\"])\n    mask, info = build_mask(img, spec)\n    rw = dspy_rewrite(request, spec[\"parts\"])\n    a, b = build_arm_a(request), build_arm_b(rw)\n    ia, ib, dt = render_pair(img, mask, a[0], a[1], b[0], b[1], strength, seed)\n    pid, _ = save_pair(img, mask, ia, ib, request, a, b, rw, info, rules,\n                       seed, strength, dt, session)\n    note = (f\"pair {pid} saved · seed {seed} · strength {strength:.2f} · {dt}s · \"\n            f\"mask {info['mask_coverage']:.1%} · rewrite {rw['source']}\")\n    return ia, ib, [(ia, \"A · your prompt\"), (ib, \"B · DSPy prompt\")], note, int(seed)\n\n# ------------------------------------------------------------------- Batch\ndef ui_scan(limit):\n    global FACES\n    FACES = find_faces(limit=int(limit), verbose=False)\n    return f\"{len(FACES)} usable source faces found\" + (\"\" if FACES else\n        \"\\n\\nAttach a face dataset via 'Add Data', or upload photos to /kaggle/working/faces/\")\n\ndef ui_batch(target, session):\n    if not FACES:\n        yield \"no faces — press Scan for faces first\"; return\n    log = []\n    for line in batch_generate(FACES, int(target), session or \"batch1\"):\n        log.append(line)\n        yield \"\\n\".join(log[-24:])\n\n# -------------------------------------------------------------- Annotation\ndef ui_packs(n, per, ov):\n    return build_packs(int(n), int(per), int(ov))\n\ndef ui_export():\n    return export_all()\n\ndef ui_pack_files():\n    return sorted(str(p) for p in PACKS.glob(\"pack_*.html\"))\n\nwith gr.Blocks(css=CSS, title=\"Vision Studio · DSPy study\", theme=gr.themes.Base()) as demo:\n    gr.HTML(HEADER)\n\n    with gr.Tabs():\n        # ------------------------------------------------------- STUDIO\n        with gr.Tab(\"Studio\"):\n            with gr.Row():\n                with gr.Column(scale=1):\n                    img_in = gr.Image(label=\"Source photo\", type=\"pil\", height=300)\n                    request = gr.Textbox(label=\"Your edit request\", lines=3,\n                        placeholder=\"e.g. smokey eye makeup and a soft nude lip\")\n                    mask_prev = gr.Image(label=\"Mask preview — orange is editable\", height=260)\n                    with gr.Row():\n                        strength = gr.Slider(0.20, 0.80, value=0.44, step=0.01, label=\"Strength\")\n                        seed_in = gr.Number(value=1234, precision=0, label=\"Seed\")\n                    rand = gr.Checkbox(value=True, label=\"New seed each generation\")\n                    session = gr.Textbox(value=\"s1\", label=\"Session tag\")\n                    go = gr.Button(\"Generate both\", variant=\"primary\", size=\"lg\")\n                with gr.Column(scale=2):\n                    with gr.Row():\n                        pa = gr.Textbox(label=\"A · prompt from your text\", lines=4,\n                                        elem_id=\"orig\", interactive=False)\n                        pb = gr.Textbox(label=\"B · prompt after DSPy rewrite\", lines=4,\n                                        elem_id=\"rw\", interactive=False)\n                    meta = gr.Textbox(label=\"Intent · mask · rewrite status\", lines=6,\n                                      elem_id=\"meta\", interactive=False)\n                    with gr.Row():\n                        out_a = gr.Image(label=\"A · your prompt\", height=360)\n                        out_b = gr.Image(label=\"B · DSPy prompt\", height=360)\n                    gallery = gr.Gallery(label=\"Side by side\", columns=2, height=300)\n                    note = gr.Textbox(label=\"Saved\", interactive=False)\n\n        # -------------------------------------------------------- BATCH\n        with gr.Tab(\"Batch\"):\n            gr.Markdown(\"Runs the 60-request variation set across your source faces. \"\n                        \"Resumable — rerun after a session drop and it skips what exists. \"\n                        \"Roughly 25-35 s per pair, so 200 pairs is about 100 minutes.\")\n            with gr.Row():\n                lim = gr.Slider(5, 60, value=40, step=5, label=\"Max source faces to scan\")\n                scan = gr.Button(\"Scan for faces\")\n            scan_out = gr.Textbox(label=\"Faces\", lines=3, interactive=False)\n            with gr.Row():\n                target = gr.Slider(10, 400, value=200, step=10, label=\"Target pairs\")\n                bsess = gr.Textbox(value=\"batch1\", label=\"Session tag\")\n            brun = gr.Button(\"Run batch\", variant=\"primary\", size=\"lg\")\n            blog = gr.Textbox(label=\"Progress\", lines=16, elem_id=\"log\", interactive=False)\n\n        # ------------------------------------------------------ DATASET\n        with gr.Tab(\"Dataset\"):\n            gr.Markdown(\"Check this before building packs. Any `haar_fallback` or \"\n                        \"`rule_fallback` rows are contaminated and should be excluded.\")\n            drep = gr.Textbox(label=\"Dataset report\", lines=12, elem_id=\"log\", interactive=False)\n            gr.Button(\"Refresh\").click(lambda: dataset_report(), None, drep)\n\n        # --------------------------------------------------- ANNOTATION\n        with gr.Tab(\"Annotation\"):\n            gr.Markdown(\"Builds one self-contained HTML file per annotator. \"\n                        \"Send each person **their own** file, not the whole zip.\")\n            with gr.Row():\n                n_ann = gr.Number(value=12, precision=0, label=\"Annotators\")\n                per   = gr.Number(value=20, precision=0, label=\"Pairs per pack (~30 s each)\")\n                ov    = gr.Number(value=2,  precision=0, label=\"Raters per pair\")\n            mk = gr.Button(\"Build packs\", variant=\"primary\")\n            plog = gr.Textbox(label=\"Packs\", lines=16, elem_id=\"log\", interactive=False)\n            files = gr.Files(label=\"Download individual packs\")\n            with gr.Row():\n                ex = gr.Button(\"Zip everything for download\")\n                refresh_f = gr.Button(\"List pack files\")\n            elog = gr.Textbox(label=\"Export\", lines=8, elem_id=\"log\", interactive=False)\n\n    # wiring\n    live_in, live_out = [img_in, request], [mask_prev, pa, pb, meta]\n    try:\n        request.change(ui_live, live_in, live_out, trigger_mode=\"always_last\",\n                       show_progress=\"minimal\")\n    except TypeError:\n        request.change(ui_live, live_in, live_out)\n    img_in.change(ui_live, live_in, live_out)\n    go.click(ui_generate, [img_in, request, seed_in, strength, rand, session],\n             [out_a, out_b, gallery, note, seed_in])\n\n    scan.click(ui_scan, lim, scan_out)\n    brun.click(ui_batch, [target, bsess], blog)\n\n    mk.click(ui_packs, [n_ann, per, ov], plog).then(ui_pack_files, None, files)\n    refresh_f.click(ui_pack_files, None, files)\n    ex.click(ui_export, None, elog)\n\n    demo.load(lambda: dataset_report(), None, drep)\n\n_app = demo.queue(max_size=8).launch(share=True, prevent_thread_lock=True)\n","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"id":"bf16fb6e-803b-487a-b3e5-181ba429ff75","cell_type":"code","source":"# ── Cell 9 · Merge annotations → final dataset → paired analysis ───────────\n#\n# Un-randomises left/right using pack_manifest.csv, joins the human scores back\n# onto the generation record, and runs the paired test. Every row of the final\n# dataset carries: source image, request, both prompts, both images, mask spec,\n# seed, model settings, annotator id and scores.\n\nfrom scipy import stats\n\ndef merge_annotations():\n    pairs = load_pairs()\n    if pairs.empty: raise RuntimeError(\"pairs.csv is empty\")\n    man = pd.read_csv(MANIFEST_CSV)\n    files = sorted(glob.glob(str(ANNOT / \"*.csv\")))\n    if not files: raise RuntimeError(f\"no annotation CSVs in {ANNOT}\")\n    ann = pd.concat([pd.read_csv(f) for f in files], ignore_index=True)\n    print(f\"loaded {len(ann)} annotation rows from {len(files)} files\")\n\n    # merge on the full key: (annotator, pair, position) is unique, (annotator, pair)\n    # is not guaranteed to be, and a many-to-many join would silently inflate n\n    keys = [\"annotator_id\", \"pair_id\", \"position\"]\n    ann = ann.merge(man[keys + [\"left_arm\"]], on=keys, how=\"left\", validate=\"one_to_one\")\n    ann = ann.dropna(subset=[\"left_arm\"])\n\n    # un-randomise: map left/right back to arm A / arm B\n    def pick(row, arm, field):\n        side = \"left\" if row[\"left_arm\"] == arm else \"right\"\n        return row.get(f\"{side}_{field}\")\n    for arm in (\"a\", \"b\"):\n        A = arm.upper()\n        for f in (\"realism\", \"identity\", \"followed\"):\n            ann[f\"{arm}_{f}\"] = ann.apply(lambda r: pick(r, A, f), axis=1)\n    ann[\"preferred_arm\"] = ann.apply(\n        lambda r: \"tie\" if r[\"preferred_side\"] == \"tie\"\n        else (r[\"left_arm\"] if r[\"preferred_side\"] == \"left\"\n              else (\"B\" if r[\"left_arm\"] == \"A\" else \"A\")), axis=1)\n\n    # annotator-centred scores (removes per-rater leniency before aggregation)\n    for f in (\"realism\", \"identity\", \"followed\"):\n        mu = ann.groupby(\"annotator_id\")[[f\"a_{f}\", f\"b_{f}\"]].transform(\"mean\").mean(axis=1)\n        ann[f\"a_{f}_c\"] = ann[f\"a_{f}\"] - mu\n        ann[f\"b_{f}_c\"] = ann[f\"b_{f}\"] - mu\n\n    final = ann.merge(pairs, on=\"pair_id\", how=\"left\", suffixes=(\"\", \"_gen\"))\n    final.to_csv(FINAL_CSV, index=False)\n    print(\"final dataset ->\", FINAL_CSV, final.shape)\n    return final\n\ndef analyse(final=None):\n    final = final if final is not None else pd.read_csv(FINAL_CSV)\n    print(f\"\\n{'='*62}\\nPAIRED ANALYSIS  ·  n = {len(final)} judgements  ·  \"\n          f\"{final.pair_id.nunique()} pairs  ·  {final.annotator_id.nunique()} annotators\\n{'='*62}\")\n\n    for f in (\"realism\", \"identity\", \"followed\"):\n        a = pd.to_numeric(final[f\"a_{f}\"], errors=\"coerce\")\n        b = pd.to_numeric(final[f\"b_{f}\"], errors=\"coerce\")\n        ok = a.notna() & b.notna()\n        a, b = a[ok], b[ok]\n        d = b - a\n        if len(d) < 5 or d.abs().sum() == 0:\n            print(f\"{f:10s} insufficient data\"); continue\n        try:\n            W, p = stats.wilcoxon(b, a, zero_method=\"wilcox\")\n        except Exception:\n            W, p = float(\"nan\"), float(\"nan\")\n        sd = d.std(ddof=1)\n        dz = d.mean()/sd if sd > 0 else 0.0\n        print(f\"{f:10s} A={a.mean():.2f}  B={b.mean():.2f}  Δ={d.mean():+.2f}  \"\n              f\"Wilcoxon p={p:.4f}  d_z={dz:+.2f}\")\n\n    pref = final.preferred_arm.value_counts()\n    nA, nB = int(pref.get(\"A\", 0)), int(pref.get(\"B\", 0))\n    nT = int(pref.get(\"tie\", 0))\n    print(f\"\\npreference   A={nA}  B={nB}  tie={nT}\")\n    if nA + nB > 0:\n        bt = stats.binomtest(nB, nA + nB, 0.5)\n        lo, hi = bt.proportion_ci(0.95)\n        print(f\"             B preferred {nB/(nA+nB):.1%} of decided pairs \"\n              f\"(95% CI {lo:.1%}–{hi:.1%}), binomial p={bt.pvalue:.4f}\")\n\n    # inter-annotator agreement on pairs seen by more than one rater\n    dup = final.groupby(\"pair_id\").filter(lambda g: len(g) > 1)\n    if len(dup):\n        agree = dup.groupby(\"pair_id\").preferred_arm.apply(lambda s: s.nunique() == 1).mean()\n        print(f\"\\nagreement    {agree:.1%} of doubly-rated pairs got the same preference \"\n              f\"({dup.pair_id.nunique()} pairs)\")\n\n    # does the rewrite help more when the original prompt is weak?\n    if \"prompt_a\" in final:\n        wl = final.prompt_a.astype(str).str.split().str.len()\n        d = pd.to_numeric(final.b_realism, errors=\"coerce\") - pd.to_numeric(final.a_realism, errors=\"coerce\")\n        ok = wl.notna() & d.notna()\n        if ok.sum() > 10 and wl[ok].nunique() > 2 and d[ok].nunique() > 1:\n            rho, p = stats.spearmanr(wl[ok], d[ok])\n            print(f\"\\nweak-prompt  Spearman(original prompt length, realism gain) \"\n                  f\"rho={rho:+.3f}  p={p:.3f}\")\n            print(\"             negative rho = DSPy helps most on short, underspecified prompts\")\n\nprint(\"Cell 9 loaded — run: final = merge_annotations(); analyse(final)\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-08T07:27:53.520953Z","iopub.execute_input":"2026-08-08T07:27:53.521751Z","iopub.status.idle":"2026-08-08T07:27:53.538184Z","shell.execute_reply.started":"2026-08-08T07:27:53.521714Z","shell.execute_reply":"2026-08-08T07:27:53.537525Z"}},"outputs":[{"name":"stdout","text":"Cell 9 loaded — run: final = merge_annotations(); analyse(final)\n","output_type":"stream"}],"execution_count":12},{"id":"b32fd34b-87cd-41ad-8d2e-5b63017cd22d","cell_type":"code","source":"for n in [\"build_mask\",\"resolve_intent\",\"render_pair\",\"dspy_rewrite\",\"selftest_lm\",\n          \"save_pair\",\"batch_generate\",\"build_packs\",\"clear_b