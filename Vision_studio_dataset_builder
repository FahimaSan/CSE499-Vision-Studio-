{"metadata":{"kernelspec":{"display_name":"Python 3","language":"python","name":"python3"},"language_info":{"name":"python","version":"3.12.13","mimetype":"text/x-python","codemirror_mode":{"name":"ipython","version":3},"pygments_lexer":"ipython3","nbconvert_exporter":"python","file_extension":".py"}},"nbformat_minor":5,"nbformat":4,"cells":[{"source":"<a href=\"https://www.kaggle.com/code/alivehues/vision-studio-dataset-builder?scriptVersionId=340955540\" target=\"_blank\"><img align=\"left\" alt=\"Kaggle\" title=\"Open in Kaggle\" src=\"https://kaggle.com/static/images/open-in-kaggle.svg\"></a>","metadata":{},"cell_type":"markdown"},{"id":"deb657a5-29d8-4fe5-9eb2-39c278764bd8","cell_type":"markdown","source":"## 11 · One-shot run — LM check, 200 pairs, packs, download\n\nRun this after cells 0-10. It stops by itself if anything is wrong, so it cannot\nproduce an unusable dataset. About 30 minutes.","metadata":{}},{"id":"bc06aaa6-be89-4561-9e9f-27b0d7f85771","cell_type":"code","source":"# ── Gemini REST backend, version-agnostic ────────────────────────────────\nimport requests, time, dspy\nfrom types import SimpleNamespace\n\nBASE = \"https://generativelanguage.googleapis.com/v1beta\"\nMODEL = \"gemini-3.1-flash-lite\"\n\ndef _gemini_call(messages, max_tokens=2048):\n    sys_txt, contents = [], []\n    for m in messages:\n        role, text = m.get(\"role\"), (m.get(\"content\") or \"\")\n        if role == \"system\":\n            sys_txt.append(text)\n        else:\n            contents.append({\"role\": \"model\" if role == \"assistant\" else \"user\",\n                             \"parts\": [{\"text\": text}]})\n    body = {\"contents\": contents,\n            \"generationConfig\": {\"temperature\": 0.7, \"topP\": 0.9,\n                                 \"maxOutputTokens\": max_tokens}}\n    if sys_txt:\n        body[\"systemInstruction\"] = {\"parts\": [{\"text\": \"\\n\\n\".join(sys_txt)}]}\n\n    last = \"\"\n    for attempt in range(4):\n        r = requests.post(f\"{BASE}/models/{MODEL}:generateContent\",\n                          params={\"key\": GEMINI_KEY}, json=body, timeout=120)\n        if r.status_code == 200:\n            d = r.json()\n            try:\n                return \"\".join(p.get(\"text\", \"\")\n                               for p in d[\"candidates\"][0][\"content\"][\"parts\"])\n            except Exception:\n                return \"\"\n        last = f\"{r.status_code} {r.text[:160]}\"\n        if r.status_code in (429, 500, 502, 503):\n            time.sleep(5 * (attempt + 1)); continue\n        break\n    raise RuntimeError(f\"Gemini REST failed — {last}\")\n\n\nclass GeminiLM(dspy.BaseLM):\n    def __init__(self):\n        super().__init__(model=MODEL)\n        self.model = MODEL\n        self.model_type = \"chat\"\n        self.kwargs = {\"temperature\": 0.7, \"max_tokens\": 2048}\n        self.history = []\n\n    # returns a LIST OF STRINGS — accepted by every DSPy version\n    def __call__(self, prompt=None, messages=None, **kw):\n        messages = messages or [{\"role\": \"user\", \"content\": prompt or \"\"}]\n        txt = _gemini_call(messages)\n        self.history.append({\"messages\": messages, \"outputs\": [txt]})\n        return [txt]\n\n    def forward(self, prompt=None, messages=None, **kw):\n        messages = messages or [{\"role\": \"user\", \"content\": prompt or \"\"}]\n        txt = _gemini_call(messages)\n        return SimpleNamespace(\n            choices=[SimpleNamespace(\n                message=SimpleNamespace(content=txt, tool_calls=None),\n                finish_reason=\"stop\")],\n            usage=SimpleNamespace(prompt_tokens=0, completion_tokens=0, total_tokens=0),\n            model=MODEL)\n\n\nLM_OBJ = GeminiLM()\ndspy.configure(lm=LM_OBJ)\nLM_BACKEND = f\"gemini-rest/{MODEL}\"\n_REWRITE_CACHE.clear(); _FIRST_ERROR.clear()\n\n# quick direct check before going through DSPy\nprint(\"direct call ->\", _gemini_call([{\"role\":\"user\",\"content\":\"Reply with OK\"}])[:40])\n\nprint(\"\\n=== self test ===\")\nselftest_lm()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-08T07:45:47.132742Z","iopub.execute_input":"2026-08-08T07:45:47.133432Z","iopub.status.idle":"2026-08-08T07:45:48.802483Z","shell.execute_reply.started":"2026-08-08T07:45:47.133403Z","shell.execute_reply":"2026-08-08T07:45:48.801837Z"}},"outputs":[{"name":"stdout","text":"direct call -> OK\n\n=== self test ===\nsource : dspy\nflags  : []\nprompt : charcoal eyeshadow, blended dark pigment, matte black gradient, soft kohl eyeliner, defined eyebrows, groomed brow hairs, natural skin texture, visible pores, subtle shimmer\n\nPASS — LM working, safe to run the batch.\n","output_type":"stream"},{"execution_count":17,"output_type":"execute_result","data":{"text/plain":"True"},"metadata":{}}],"execution_count":17},{"id":"2dc26f23-172c-451b-87ba-023987e1fe0d","cell_type":"code","source":"clear_batch()\nFACES = find_faces(limit=40)\nrun_batch(FACES, 200)\nprint(dataset_report())\nprint(build_packs(12, 20, 2))\nprint(export_all())","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-08T07:46:05.604719Z","iopub.execute_input":"2026-08-08T07:46:05.605236Z","iopub.status.idle":"2026-08-08T08:12:38.566581Z","shell.execute_reply.started":"2026-08-08T07:46:05.605209Z","shell.execute_reply":"2026-08-08T08:12:38.565636Z"}},"outputs":[{"name":"stdout","text":"cleared — no pairs recorded yet\nscanned 4964 files, kept 40 with a detected face\nloading Uminosachi/realisticVisionV51_v51VAE-inpainting ...\n","output_type":"stream"},{"name":"stderr","text":"Warning: You are sending unauthenticated requests to the HF Hub. Please set a HF_TOKEN to enable higher rate limits and faster downloads.\nWARNING:huggingface_hub.utils._http:Warning: You are sending unauthenticated requests to the HF Hub. Please set a HF_TOKEN to enable higher rate limits and faster downloads.\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":